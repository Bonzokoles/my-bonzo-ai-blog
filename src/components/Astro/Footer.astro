---
// Component for rendering a consistent footer across pages.
// UPDATED: Now featuring a massive full-width logo/badge at the bottom.

import logo from "@assets/bonzo_logo_new.png"; // Używamy logo.png jako "małego znaczka" do powiększenia
import Link from "@components/Astro/Link.astro";
import { Image } from "astro:assets";
import { SITE } from "src/alkaline.config";
import SocialsCloud from "./SocialsCloud.astro";

interface Props {
	title?: string | undefined;
	author?: string | undefined;
	portfolio?: string | undefined;
	class?: string | undefined;
}

const { title = SITE.title, author, portfolio, class: className }: Props = Astro.props;
---

<footer class:list={["mt-auto mb-0 pb-0 relative overflow-hidden", className]}>
	<!-- Full Width Massive Logo Background -->
	<div class="absolute inset-0 z-0 pointer-events-none flex items-center justify-center overflow-hidden">
		<!-- Powiększony znaczek (logo) na całą szerokość - white/inverted for dark mode -->
		<Image 
			src={logo} 
			alt="" 
			class="w-full h-auto min-w-[100%] object-cover opacity-40"
		/>
	</div>

	<!-- Content -->
	<div class="relative z-10 container mx-auto px-4 py-12">
		
		<!-- Górna część stopki: Wielki napis BONZO -->
		<div class="w-full text-center mb-10 border-b border-theme-accent/20 pb-10">
			<h2 class="text-[15vw] leading-none font-black text-transparent bg-clip-text bg-gradient-to-r from-theme-primary/10 via-theme-accent/20 to-theme-primary/10 select-none font-mono tracking-tighter">
				BONZO_AI
			</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
			<div>
				<h3 class="text-xl font-bold text-theme-accent mb-4">MyBonzo AI Blog</h3>
				<p class="text-sm text-theme-primary/70 max-w-xs mx-auto md:mx-0">
					Centrum wiedzy o sztucznej inteligencji. Przyszłość w Twoich rękach.
				</p>
			</div>
			
			<div class="flex flex-col items-center justify-center">
				<SocialsCloud socials={SITE.socials} class="opacity-80"/>
			</div>

			<div class="flex flex-col items-center md:items-end justify-center">
				<p class="text-sm">
					&copy; {new Date().getFullYear()} {title}
				</p>
				{author && (
					<p class="text-xs mt-2 opacity-60">
						Created by {portfolio ? <Link href={portfolio} text={author} external hideIcon class="hover:text-theme-accent transition-colors"/> : author}
					</p>
				)}
			</div>
		</div>
	</div>
</footer>
