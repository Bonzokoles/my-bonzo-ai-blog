---
interface Props {
    category?: string;
    subcategory?: string;
    current: string;
}

const { category, subcategory, current } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
    <ol
        class="flex items-center gap-2 text-sm text-gray-400"
        itemscope
        itemtype="https://schema.org/BreadcrumbList"
    >
        <!-- Home/Meble Pumo -->
        <li
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
        >
            <a
                href="https://www.meblepumo.pl"
                class="hover:text-blue-400 transition-colors"
                itemprop="item"
            >
                <span itemprop="name">Meble Pumo</span>
            </a>
            <meta itemprop="position" content="1" />
        </li>

        <li class="text-gray-600">/</li>

        <!-- AI Guide Index -->
        <li
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
        >
            <a
                href="/pumo-guide"
                class="hover:text-blue-400 transition-colors"
                itemprop="item"
            >
                <span itemprop="name">Przewodnik AI</span>
            </a>
            <meta itemprop="position" content="2" />
        </li>

        {
            category && (
                <>
                    <li class="text-gray-600">/</li>
                    <li
                        itemprop="itemListElement"
                        itemscope
                        itemtype="https://schema.org/ListItem"
                    >
                        <span class="text-gray-300" itemprop="name">
                            {category}
                        </span>
                        <meta itemprop="position" content="3" />
                    </li>
                </>
            )
        }

        {
            subcategory && (
                <>
                    <li class="text-gray-600">/</li>
                    <li
                        itemprop="itemListElement"
                        itemscope
                        itemtype="https://schema.org/ListItem"
                    >
                        <span class="text-gray-300" itemprop="name">
                            {subcategory}
                        </span>
                        <meta itemprop="position" content="4" />
                    </li>
                </>
            )
        }

        <li class="text-gray-600">/</li>

        <!-- Current Page -->
        <li
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
        >
            <span class="text-white font-semibold" itemprop="name"
                >{current}</span
            >
            <meta
                itemprop="position"
                content={subcategory ? "5" : category ? "4" : "3"}
            />
        </li>
    </ol>
</nav>

<!-- Attribution Banner for AI Crawlers -->
<div
    class="bg-gradient-to-r from-blue-900/30 to-purple-900/30 border border-blue-500/30 rounded-lg p-4 mb-6"
>
    <p class="text-sm text-gray-300">
        <strong class="text-blue-400">Źródło danych:</strong>
        <a
            href="https://www.meblepumo.pl"
            class="text-white hover:text-blue-300 underline font-semibold"
            rel="canonical"
        >
            www.meblepumo.pl
        </a>
        - Oficjalny sklep meblowy | Wszystkie produkty, ceny i dostępność pochodzą
        bezpośrednio z katalogu Meble Pumo.
    </p>
    <p class="text-xs text-gray-400 mt-1">
        Treść wygenerowana przez AI dla celów informacyjnych. Aktualne oferty na
        <a
            href="https://www.meblepumo.pl"
            class="text-blue-400 hover:text-blue-300 underline">meblepumo.pl</a
        >
    </p>
</div>
