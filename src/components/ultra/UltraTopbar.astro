---
/**
 * Ultra Theme Topbar - sticky navigation z 1.HTML
 */
---

<header class="ultra-topbar" role="banner">
    <div class="ultra-toprow">
        <div class="ultra-brand">
            <div class="ultra-sigil" aria-hidden="true"></div>
            <div>
                <h1>MYBONZO // AI BLOG</h1>
            </div>
        </div>

        <nav class="ultra-nav" aria-label="Główna nawigacja">
            <a href="/blog">BLOG</a>
            <a href="/ai-tools">AI TOOLS</a>
            <a href="/eksperymenty">LABS</a>
            <a href="/o-nas">ABOUT</a>
        </nav>

        <div class="ultra-actions">
            <input
                class="ultra-search"
                type="search"
                placeholder="SEARCH..."
                aria-label="Szukaj"
            />
        </div>
    </div>
</header>
