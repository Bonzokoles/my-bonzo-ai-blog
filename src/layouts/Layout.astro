---
// Layout component that wraps around pages and blog posts, providing consistent structure and styling. you can read more about it here: https://docs.astro.build/en/guides/layouts/

import { NAVIGATION, SITE } from "src/alkaline.config";

import { ClientRouter } from "astro:transitions";

import "@styles/global.css";

import ParticleBackground from "@components/Vue/AI/ParticleBackground.vue";

import DynamicMetaTags from "@components/Astro/head/DynamicMetaTags.astro";
import GoogleFonts from "@components/Astro/head/GoogleFonts.astro";
import SocialMeta from "@components/Astro/head/SocialMeta.astro";
// import ResourceLinks from "@components/Astro/head/ResourceLinks.astro";
import BackToTop from "@components/Astro/BackToTop.astro";
import Footer from "@components/Astro/Footer.astro";
import Nav from "@components/Astro/Nav.astro";
import QuickAccessWidget from "@components/Astro/QuickAccessWidget.astro";
import Title from "@components/Astro/Title.astro";

import logo from "@assets/bonzo_logo_new.png";

interface Props {
  title?: string;
  author?: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  canonicalUrl?: string;
  faviconSrc?: string;
  showTitleBackground?: boolean;
  class?: string | undefined;
  lang?: string;
  // AI SEO Props
  robots?: string;      // Override default robots meta
  googlebot?: string;   // Specific rules for Googlebot (AI Overviews)
  maxSnippet?: number;  // Limit snippet length (default -1 = unlimited)
}

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.description || SITE.title,
  faviconSrc = SITE.faviconSrc,
  keywords = SITE.keywords,
  ogImage = SITE.ogImage,
  canonicalUrl = SITE.canonicalUrl,
  showTitleBackground = SITE.showTitleBackground || false,
  publishedTime = "",
  modifiedTime = "",
  class: className = "",
  lang = "pl",
  robots,
  googlebot,
  maxSnippet,
} = Astro.props;

// Construct robots meta content
let robotsContent = robots;
if (!robotsContent) {
    robotsContent = `index, ${SITE.disableIndexing ? "noindex, nofollow" : "index, follow"}`;
}
if (maxSnippet) {
    // Append max-snippet if not already present
    if (!robotsContent.includes('max-snippet')) {
        robotsContent += `, max-snippet:${maxSnippet}`;
    }
}

const metaTags = [
  { name: "viewport", content: "width=device-width, initial-scale=1.0" },
  { name: "generator", content: "Astro" },
  { name: "sitemap", content: "/sitemap-index.xml" },
  {
    name: "robots",
    content: robotsContent,
  },
  // GEO TAGS FOR POLAND TARGETING
  { name: "geo.region", content: "PL" },
  { name: "geo.position", content: "52.237049;21.017532" },
  { name: "ICBM", content: "52.237049, 21.017532" },
];

if (googlebot) {
    metaTags.push({ name: "googlebot", content: googlebot });
}
const fonts = SITE.fonts || [];

// @ts-ignore
const headerLogo = typeof logo === "undefined" ? null : logo; // guard against no logo

// Prepare logo URL for Schema.org (use full URL with domain)
const siteUrl = SITE.url || "https://mybonzoaiblog.com";
const logoUrl = logo?.src ? new URL(logo.src, siteUrl).href : `${siteUrl}/bonzo_logo_new.png`;
---

<html lang={lang}>
  <head>
    <!-- Bing Webmaster Verification -->
    <meta name="msvalidate.01" content="610D2A75B0BD3CE029E40BEF8B91F851" />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="AI Blog - Przewodnik po Meblach Pumo"
      href="/rss.xml"
    />

    <DynamicMetaTags metaTags={metaTags} />
    <GoogleFonts fonts={fonts} />
    
    <!-- Global Schema.org for AI Crawlers -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "MyBonzo AI Blog",
          "url": siteUrl,
          "logo": {
            "@type": "ImageObject",
            "url": logoUrl,
            "width": 512,
            "height": 512
          },
          "sameAs": [
            "https://github.com/Bonzokoles",
            "https://mybonzoaiblog.pages.dev",
            "https://twitter.com/Bonzokoles"
          ],
          "description": "Blog o sztucznej inteligencji, machine learning i nowoczesnych technologiach AI. Przewodniki, case studies i praktyczne zastosowania AI dla polskich użytkowników.",
          "founder": {
            "@type": "Person",
            "name": "Bonzo",
            "jobTitle": "AI Developer & Content Creator"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Customer Service",
            "areaServed": "PL",
            "availableLanguage": ["Polish", "English"]
          },
          "foundingDate": "2025"
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "MyBonzo AI Blog",
          "description": "Kompleksowy przewodnik po sztucznej inteligencji: tutoriale, case studies, narzędzia AI i aktualne trendy w ML/AI",
          "publisher": {
            "@id": `${siteUrl}/#organization`
          },
          "inLanguage": "pl-PL",
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": `${siteUrl}/search?q={search_term_string}`
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "ItemList",
          "@id": `${siteUrl}/#mainnavigation`,
          "name": "Main Navigation",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Blog",
              "url": `${siteUrl}/blog`
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Meble Pumo Guide",
              "url": `${siteUrl}/pumo-guide`
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "RAG Assistant",
              "url": `${siteUrl}/rag`
            },
            {
              "@type": "ListItem",
              "position": 4,
              "name": "AI Tools",
              "url": `${siteUrl}/eksperymenty`
            }
          ]
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${siteUrl}/#breadcrumb`,
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": siteUrl
              }
            ]
        }
      ]
    })} />
    
    <SocialMeta
      title={title}
      author={author}
      ogImage={ogImage || SITE.ogImage}
      description={description}
      keywords={keywords}
      canonicalURL={canonicalUrl}
      faviconSrc={faviconSrc}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    
    <ClientRouter />
    {/*<ResourceLinks />*/}
    

  </head>
  <body class:list={[className]}>
    <ParticleBackground client:load />
    <div class="flex flex-col min-h-screen mt-0 pt-0 relative z-10">
      {
        headerLogo ? (
          <Title
            title={title}
            showTitleBackground={showTitleBackground}
            logoImg={headerLogo}
          />
        ) : (
          <Title title={title} showTitleBackground={showTitleBackground} />
        )
      }
      <Nav links={NAVIGATION} />
      <main class="flex-grow">
        <!-- content -->
        <slot />
      </main>
      <Footer
        author={SITE.author}
        portfolio={SITE.socials.find((social) => social.platform === "web")
          ?.url}
      />
    </div>
    <BackToTop />
    <QuickAccessWidget />
    <QuickAccessWidget />
    
    <!-- Global Pumo Analytics Tracker -->
    <script>
      import { pumoTracker } from "../lib/pumo-tracker";

      document.addEventListener('click', (e) => {
        const target = (e.target as Element).closest('a');
        if (target && target.href) {
          // Track shop clicks
          if (target.href.includes('meblepumo.pl')) {
            pumoTracker.trackClick({
              id: 'shop_link',
              name: target.innerText || target.getAttribute('title') || 'Shop Link',
              url: target.href
            });
          }
          // Track guide clicks (internal)
          else if (target.href.includes('/pumo-guide/')) {
            pumoTracker.trackGuideView(target.pathname, target.innerText);
          }
        }
      });
    </script>
  </body>
</html>
