---
import Layout from "@/layouts/Layout.astro";
---

<Layout
    title="UTM Analytics Dashboard - MyBonzo AI Blog"
    description="Monitor UTM tracking performance and revenue attribution"
>
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold mb-4">📊 UTM Analytics Dashboard</h1>
            <p class="text-gray-600 dark:text-gray-400">
                Monitor UTM tracking performance across WHITECAT API, Guide
                Generator, and RAG Chat
            </p>
        </div>

        <!-- Quick Actions -->
        <div class="mb-6 flex flex-wrap gap-4">
            <button
                onclick="setupDatabase()"
                class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
            >
                Setup Database
            </button>
            <button
                onclick="loadStats()"
                class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700"
            >
                Refresh Stats
            </button>
            <button
                onclick="testTracking()"
                class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700"
            >
                Test Tracking
            </button>
        </div>

        <!-- Status Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                <h3 class="text-lg font-semibold mb-2">🎯 Total Clicks</h3>
                <p class="text-3xl font-bold text-blue-600" id="total-clicks">
                    -
                </p>
                <p class="text-sm text-gray-500">Last 7 days</p>
            </div>

            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                <h3 class="text-lg font-semibold mb-2">👥 Unique Visitors</h3>
                <p
                    class="text-3xl font-bold text-green-600"
                    id="unique-visitors"
                >
                    -
                </p>
                <p class="text-sm text-gray-500">Distinct IP addresses</p>
            </div>

            <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
                <h3 class="text-lg font-semibold mb-2">📈 Top Campaign</h3>
                <p class="text-xl font-bold text-purple-600" id="top-campaign">
                    -
                </p>
                <p class="text-sm text-gray-500">Best performing</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow mb-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-2">Days</label>
                    <select
                        id="days-filter"
                        class="w-full p-2 border rounded dark:bg-gray-700"
                    >
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 90 days</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2"
                        >UTM Source</label
                    >
                    <select
                        id="source-filter"
                        class="w-full p-2 border rounded dark:bg-gray-700"
                    >
                        <option value="">All sources</option>
                        <option value="mybonzo">mybonzo</option>
                        <option value="test">test</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2"
                        >UTM Medium</label
                    >
                    <select
                        id="medium-filter"
                        class="w-full p-2 border rounded dark:bg-gray-700"
                    >
                        <option value="">All mediums</option>
                        <option value="whitecat">whitecat</option>
                        <option value="guide">guide</option>
                        <option value="rag_chat">rag_chat</option>
                    </select>
                </div>

                <div class="flex items-end">
                    <button
                        onclick="loadStats()"
                        class="w-full bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700"
                    >
                        Apply Filters
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats Table -->
        <div
            class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden"
        >
            <div
                class="px-6 py-4 border-b border-gray-200 dark:border-gray-700"
            >
                <h3 class="text-lg font-semibold">📊 UTM Performance Stats</h3>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr>
                            <th
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"
                                >Campaign</th
                            >
                            <th
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"
                                >Source</th
                            >
                            <th
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"
                                >Medium</th
                            >
                            <th
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"
                                >Clicks</th
                            >
                            <th
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"
                                >Unique</th
                            >
                            <th
                                class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"
                                >Date</th
                            >
                        </tr>
                    </thead>
                    <tbody
                        id="stats-table"
                        class="divide-y divide-gray-200 dark:divide-gray-700"
                    >
                        <tr>
                            <td
                                colspan="6"
                                class="px-6 py-4 text-center text-gray-500"
                            >
                                Click "Load Stats" to view analytics data
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- System Status -->
        <div class="mt-8 bg-white dark:bg-gray-800 p-6 rounded-lg shadow">
            <h3 class="text-lg font-semibold mb-4">🔧 System Status</h3>
            <div id="system-status" class="space-y-2">
                <p>Loading system status...</p>
            </div>
        </div>
    </div>

    <script>
        // Global state
        let analyticsData = {};

        // Setup database
        async function setupDatabase() {
            try {
                const response = await fetch("/api/analytics/setup-db", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                });

                const result = await response.json();

                if (result.success) {
                    alert("✅ Database setup completed successfully!");
                    checkSystemStatus();
                } else {
                    alert("❌ Database setup failed: " + result.error);
                }
            } catch (error) {
                alert("❌ Database setup error: " + error.message);
            }
        }

        // Load analytics stats
        async function loadStats() {
            const days = document.getElementById("days-filter").value;
            const source = document.getElementById("source-filter").value;
            const medium = document.getElementById("medium-filter").value;

            const params = new URLSearchParams({ days });
            if (source) params.append("utm_source", source);
            if (medium) params.append("utm_medium", medium);

            try {
                const response = await fetch(
                    `/api/analytics/utm-tracking?${params}`,
                );
                const result = await response.json();

                if (result.success) {
                    analyticsData = result.data;
                    updateDashboard(result.data);
                } else {
                    alert("❌ Failed to load stats: " + result.error);
                    if (result.error.includes("Analytics table not found")) {
                        if (
                            confirm("Analytics table not found. Create it now?")
                        ) {
                            await setupDatabase();
                        }
                    }
                }
            } catch (error) {
                alert("❌ Load stats error: " + error.message);
            }
        }

        // Update dashboard with data
        function updateDashboard(data) {
            const stats = data.stats || [];

            // Update summary cards
            const totalClicks = stats.reduce(
                (sum, row) => sum + (row.clicks || 0),
                0,
            );
            const uniqueVisitors = stats.reduce(
                (sum, row) => sum + (row.unique_visitors || 0),
                0,
            );
            const topCampaign =
                stats.length > 0 ? stats[0].utm_campaign || "None" : "None";

            document.getElementById("total-clicks").textContent =
                totalClicks.toLocaleString();
            document.getElementById("unique-visitors").textContent =
                uniqueVisitors.toLocaleString();
            document.getElementById("top-campaign").textContent = topCampaign;

            // Update table
            const tbody = document.getElementById("stats-table");
            if (stats.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-6 py-4 text-center text-gray-500">
                            No analytics data found for selected period
                        </td>
                    </tr>
                `;
            } else {
                tbody.innerHTML = stats
                    .map(
                        (row) => `
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">${row.utm_campaign || "-"}</td>
                        <td class="px-6 py-4 whitespace-nowrap">${row.utm_source || "-"}</td>
                        <td class="px-6 py-4 whitespace-nowrap">${row.utm_medium || "-"}</td>
                        <td class="px-6 py-4 whitespace-nowrap font-medium">${row.clicks || 0}</td>
                        <td class="px-6 py-4 whitespace-nowrap">${row.unique_visitors || 0}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${row.date || "-"}</td>
                    </tr>
                `,
                    )
                    .join("");
            }
        }

        // Test UTM tracking
        async function testTracking() {
            const testData = {
                url: "https://www.meblepumo.pl/test-product?utm_source=mybonzo&utm_medium=test&utm_campaign=dashboard_test&utm_content=button",
                utm_source: "mybonzo",
                utm_medium: "test",
                utm_campaign: "dashboard_test",
                utm_content: "button",
            };

            try {
                const response = await fetch("/api/analytics/utm-tracking", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(testData),
                });

                const result = await response.json();

                if (result.success) {
                    alert("✅ Test tracking successful!");
                    loadStats(); // Refresh stats
                } else {
                    alert("❌ Test tracking failed: " + result.error);
                }
            } catch (error) {
                alert("❌ Test tracking error: " + error.message);
            }
        }

        // Check system status
        async function checkSystemStatus() {
            try {
                const response = await fetch("/api/analytics/setup-db");
                const result = await response.json();

                const statusEl = document.getElementById("system-status");
                if (result.success && result.table_exists) {
                    statusEl.innerHTML = `
                        <p class="text-green-600">✅ Analytics database ready</p>
                        <p class="text-sm text-gray-600">Records: ${result.record_count || 0}</p>
                    `;
                } else {
                    statusEl.innerHTML = `
                        <p class="text-red-600">❌ Analytics database not ready</p>
                        <p class="text-sm text-gray-600">Click "Setup Database" to initialize</p>
                    `;
                }
            } catch (error) {
                document.getElementById("system-status").innerHTML = `
                    <p class="text-red-600">❌ System check failed</p>
                    <p class="text-sm text-gray-600">${error.message}</p>
                `;
            }
        }

        // Initialize dashboard
        document.addEventListener("DOMContentLoaded", () => {
            checkSystemStatus();
        });

        // Auto-refresh every 5 minutes
        setInterval(
            () => {
                if (analyticsData.stats) {
                    loadStats();
                }
            },
            5 * 60 * 1000,
        );
    </script>
</Layout>
