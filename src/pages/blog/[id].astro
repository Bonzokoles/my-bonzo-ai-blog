---
import Layout from "@layouts/Layout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

// Robust match: /blog/<id> where <id> may be "post.mdx", "post.md", or "post"
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.isDraft)
    .map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;

// Load all posts and find matching by:
// - exact id (e.g. "my-post.mdx")
// - id without extension (e.g. "my-post")
const posts = await getCollection("blog");
const post =
  posts.find((p) => p.id === id) ||
  posts.find((p) => stripExt(p.id) === id) ||
  null;

function stripExt(s = "") {
  return s.replace(/\.(md|mdx)$/i, "");
}

if (!post) {
  // fallback 404-ish
  // (Astro will still generate static pages from getStaticPaths,
  // but this protects against manual URLs)
  throw new Error(`Post not found for id: ${id}`);
}

const title = post.data.title ?? "Blog";
const description = post.data.description ?? "";
const pubDate = post.data.pubDatetime
  ? new Date(post.data.pubDatetime).toISOString().slice(0, 10)
  : null;

const tags = Array.isArray(post.data.tags) ? post.data.tags : [];
const cover = post.data.coverImage || null;

// Astro content entry render
const { Content } = await render(post);
---

<Layout class="theme-ultra" title={title} description={description}>
  <main class="ultra-stage min-h-screen">
    <div class="max-w-4xl mx-auto px-4 py-10">
      <Breadcrumbs 
        items={[
          { name: "Home", url: "/" },
          { name: "Blog", url: "/blog" },
          { name: title, current: true }
        ]}
      />
      <article class="ultra-panel border border-gray-700/40 bg-black/35 p-6 md:p-8">
        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-3 text-xs opacity-80">
            {pubDate && <span class="ultra-muted font-mono tracking-wide">DATE: {pubDate}</span>}
            {tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {tags.slice(0, 8).map((t) => (
                  <a
                    href={`/blog/tags/${encodeURIComponent(t)}`}
                    class="border border-gray-700/60 px-2 py-1 font-mono text-[11px] hover:text-[var(--color-accent-alt)]"
                  >
                    {t}
                  </a>
                ))}
              </div>
            )}
          </div>

          <h1 class="mt-4 text-3xl md:text-4xl font-black tracking-tight">
            {title}
          </h1>

          {description && (
            <p class="mt-3 text-base md:text-lg ultra-muted">
              {description}
            </p>
          )}

          {cover && (
            <div class="mt-6 border border-gray-700/50 bg-black/30">
              <!-- jeśli to jest URL, zadziała od razu -->
              <img src={cover} alt={title} class="w-full h-auto block" loading="lazy" />
            </div>
          )}

          <div class="mt-6 flex items-center justify-between gap-4">
            <a
              href="/blog/1"
              class="border border-gray-700/60 px-3 py-2 font-mono text-xs hover:text-[var(--color-accent-alt)]"
            >
              ← BACK
            </a>

            <div class="font-mono text-[11px] ultra-muted">
              ID: {post.id}
            </div>
          </div>
        </header>

        <!-- Content typography lives here -->
        <div class="prose prose-invert max-w-none">
          <Content />
        </div>
      </article>
    </div>
  </main>
</Layout>
