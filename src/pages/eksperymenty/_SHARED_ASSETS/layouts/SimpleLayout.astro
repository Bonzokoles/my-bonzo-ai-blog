---
// SimpleLayout.astro - Uproszczony layout z wyglądem głównego bloga MyBonzo
// Do użycia w projektach AIBLOG (Q:\mybonzo\AIBLOG\*)
// Źródło: Q:\mybonzo\mybonzoAIblog\src\layouts\Layout.astro (uproszczona wersja)

interface Props {
    title?: string;
    description?: string;
    author?: string;
    class?: string;
}

const {
    title = "MyBonzo AI Lab",
    description = "Eksperymentalne funkcje AI",
    author = "MyBonzo",
    class: className = "",
} = Astro.props;

const currentUrl = Astro.url.pathname;
const blogUrl = "https://mybonzo.com"; // Link powrotu do głównego bloga
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
    <head>
        <!-- Meta Tags -->
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content="Astro" />
        <meta name="description" content={description} />
        <meta name="author" content={author} />

        <!-- SEO -->
        <title>{title}</title>
        <link rel="canonical" href={Astro.url} />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Fonts: Throlacon (Graffiti Headers) -->
        <style>
            @font-face {
                font-family: "ThrolaconTrial";
                src: url("/fonts/Throlacon Trial.ttf") format("truetype");
                font-weight: normal;
                font-style: normal;
            }
        </style>

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
    </head>

    <body class:list={["min-h-screen flex flex-col", className]}>
        <!-- Simple Navbar -->
        <nav
            class="sticky top-0 z-50 bg-theme-primary/80 backdrop-blur-lg border-b border-theme-accent/20"
        >
            <div
                class="container mx-auto px-4 py-4 flex justify-between items-center"
            >
                <a
                    href={blogUrl}
                    class="text-lg font-bold text-theme-accent hover:text-theme-accent-hover transition"
                >
                    ← MyBonzo Blog
                </a>
                <span class="text-theme-primary font-mono text-sm">
                    {title}
                </span>
            </div>
        </nav>

        <!-- Main Content -->
        <main
            class="flex-grow bg-gradient-to-br from-theme-primary via-theme-secondary to-theme-primary"
        >
            <slot />
        </main>

        <!-- Simple Footer -->
        <footer class="bg-theme-secondary/50 border-t border-theme-accent/20">
            <div class="container mx-auto px-4 py-6 text-center">
                <p class="text-theme-primary/70 text-sm">
                    Powered by <a
                        href={blogUrl}
                        class="text-theme-accent hover:underline">MyBonzo</a
                    >
                    · {new Date().getFullYear()}
                </p>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    /* Import theme colors */
    :root {
        /* Light Mode */
        --theme-primary: #1a1a2e;
        --theme-secondary: #16213e;
        --theme-accent: #0f3460;
        --theme-accent-hover: #e94560;
        --theme-text: #eaeaea;
        --theme-text-muted: #a0a0a0;
    }

    html.dark {
        /* Dark Mode */
        --theme-primary: #0f0f23;
        --theme-secondary: #1a1a2e;
        --theme-accent: #e94560;
        --theme-accent-hover: #ff6b6b;
        --theme-text: #ffffff;
        --theme-text-muted: #888888;
    }

    /* Utility Classes */
    .bg-theme-primary {
        background-color: var(--theme-primary);
    }
    .bg-theme-secondary {
        background-color: var(--theme-secondary);
    }
    .bg-theme-accent {
        background-color: var(--theme-accent);
    }
    .text-theme-primary {
        color: var(--theme-text);
    }
    .text-theme-accent {
        color: var(--theme-accent);
    }
    .text-theme-accent-hover {
        color: var(--theme-accent-hover);
    }
    .border-theme-accent {
        border-color: var(--theme-accent);
    }

    /* Typography */
    body {
        font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto",
            "Helvetica Neue", sans-serif;
        color: var(--theme-text);
        background-color: var(--theme-primary);
    }

    /* Graffiti Headers (Throlacon) */
    h1,
    h2,
    h3,
    h4,
    h5 {
        font-family:
            "ThrolaconTrial", Impact, "Arial Black", sans-serif !important;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        font-weight: normal !important;
        text-shadow:
            0 2px 8px rgba(18, 18, 18, 0.4),
            2px 2px 0 rgba(51, 51, 51, 0.1);
        color: var(--theme-accent);
    }

    h1 {
        font-size: 3.5rem;
    }
    h2 {
        font-size: 2.5rem;
    }
    h3 {
        font-size: 2rem;
    }
    h4 {
        font-size: 1.5rem;
    }
    h5 {
        font-size: 1.25rem;
    }

    /* Links */
    a {
        transition: all 0.3s ease;
    }

    a:hover {
        color: var(--theme-accent-hover);
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-track {
        background: var(--theme-primary);
    }

    ::-webkit-scrollbar-thumb {
        background: var(--theme-accent);
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--theme-accent-hover);
    }
</style>
