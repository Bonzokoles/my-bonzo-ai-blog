---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="AI Chat - Bonzo AI Assistant"
    description="Rozmawiaj z AI asytentem Bonzo"
>
    <div
        class="w-full min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900"
    >
        <div class="container mx-auto px-4 py-8">
            <div class="max-w-6xl mx-auto">
                <div class="mb-8 text-center">
                    <h1 class="text-4xl font-bold text-white mb-4">
                        🤖 AI Chat Assistant
                    </h1>
                    <p class="text-gray-300 text-lg">
                        Eksperymentalny chatbot z OpenAI GPT-4
                    </p>
                </div>

                <div
                    class="bg-white rounded-2xl shadow-2xl overflow-hidden"
                    style="height: calc(100vh - 250px); min-height: 600px;"
                >
                    <iframe
                        src="https://main.bonzo-ai-chat.pages.dev"
                        class="w-full h-full border-0"
                        title="Bonzo AI Chat"
                        allow="clipboard-write"
                        loading="lazy"></iframe>
                </div>

                <div class="mt-6 text-center text-sm text-gray-400">
                    <p>
                        Powered by Cloudflare Pages + OpenAI GPT-4 |
                        <a
                            href="https://github.com/Bonzokoles/bonzo-ai-chat"
                            target="_blank"
                            rel="noopener"
                            class="text-purple-400 hover:text-purple-300 underline"
                        >
                            Zobacz kod na GitHub
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    /* Ensure iframe fills container */
    iframe {
        display: block;
    }
</style>
