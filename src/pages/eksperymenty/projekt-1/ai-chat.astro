---
import Layout from "@layouts/Layout.astro";

const CHAT_URL = "https://main.bonzo-ai-chat.pages.dev";
const WORKER_PROXY_URL =
    "https://mybonzo-proxy-worker.stolarnia-ams.workers.dev";
---

<Layout
    title="MyBonzo AI Chat - Inteligentny Asystent AI"
    description="Rozmawiaj z zaawansowanymi modelami AI. Wsparcie dla GPT-4, streaming, role presets i załączników."
>
    <div class="container mx-auto px-4 py-8 max-w-7xl">
        <!-- Breadcrumb -->
        <nav class="mb-6 text-sm" aria-label="Breadcrumb">
            <ol class="flex items-center space-x-2">
                <li>
                    <a
                        href="/"
                        class="text-blue-600 dark:text-blue-400 hover:underline"
                        >Home</a>
                </li>
                <li class="text-gray-400">/</li>
                <li>
                    <a
                        href="/eksperymenty"
                        class="text-blue-600 dark:text-blue-400 hover:underline"
                        >Eksperymenty</a>
                </li>
                <li class="text-gray-400">/</li>
                <li class="text-gray-600 dark:text-gray-300">AI Chat</li>
            </ol>
        </nav>

        <!-- Header -->
        <header class="mb-8">
            <h1
                class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent"
            >
                🤖 MyBonzo AI Chat
            </h1>
            <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl">
                Inteligentny asystent AI z wieloma modelami OpenAI. Wspiera
                streaming, role presets i załączniki plików.
            </p>
        </header>

        <!-- Stats/Features Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
            <div
                class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 p-4 rounded-lg border border-purple-200 dark:border-purple-700"
            >
                <div class="text-2xl mb-2">💬</div>
                <div
                    class="text-sm font-semibold text-purple-900 dark:text-purple-100"
                >
                    Multi-Model
                </div>
                <div class="text-xs text-purple-700 dark:text-purple-300">
                    GPT-4 & GPT-3.5
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-pink-50 to-pink-100 dark:from-pink-900/20 dark:to-pink-800/20 p-4 rounded-lg border border-pink-200 dark:border-pink-700"
            >
                <div class="text-2xl mb-2">⚡</div>
                <div
                    class="text-sm font-semibold text-pink-900 dark:text-pink-100"
                >
                    Streaming
                </div>
                <div class="text-xs text-pink-700 dark:text-pink-300">
                    Odpowiedzi na żywo
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 p-4 rounded-lg border border-blue-200 dark:border-blue-700"
            >
                <div class="text-2xl mb-2">🎭</div>
                <div
                    class="text-sm font-semibold text-blue-900 dark:text-blue-100"
                >
                    Role Presets
                </div>
                <div class="text-xs text-blue-700 dark:text-blue-300">
                    4 gotowe role
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 p-4 rounded-lg border border-green-200 dark:border-green-700"
            >
                <div class="text-2xl mb-2">📎</div>
                <div
                    class="text-sm font-semibold text-green-900 dark:text-green-100"
                >
                    Załączniki
                </div>
                <div class="text-xs text-green-700 dark:text-green-300">
                    Pliki tekstowe
                </div>
            </div>
        </div>

        <!-- Chat Iframe -->
        <div
            class="relative w-full bg-white dark:bg-gray-800 rounded-xl shadow-2xl overflow-hidden border-2 border-gray-200 dark:border-gray-700 mb-8"
        >
            <!-- Loading Indicator -->
            <div
                id="iframe-loader"
                class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-purple-50 to-pink-50 dark:from-gray-900 dark:to-purple-900 z-10"
            >
                <div class="text-center">
                    <div
                        class="animate-spin rounded-full h-16 w-16 border-4 border-purple-500 border-t-transparent mb-4 mx-auto"
                    >
                    </div>
                    <p class="text-purple-600 dark:text-purple-300 font-medium">
                        Ładowanie AI Chat...
                    </p>
                </div>
            </div>

            <!-- Iframe -->
            <iframe
                id="chat-iframe"
                src={CHAT_URL}
                class="w-full h-[800px] md:h-[900px]"
                title="MyBonzo AI Chat"
                allow="clipboard-write"
                loading="lazy"
                onload="document.getElementById('iframe-loader').style.display='none'"
            ></iframe>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-4 justify-center mb-8">
            <a
                href={CHAT_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-lg hover:from-purple-700 hover:to-pink-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
                <svg
                    class="w-5 h-5 mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    ></path>
                </svg>
                Otwórz w nowym oknie
            </a>

            <a
                href="https://github.com/Bonzokoles/bonzo-ai-chat"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-6 py-3 bg-gray-800 dark:bg-gray-700 text-white font-semibold rounded-lg hover:bg-gray-900 dark:hover:bg-gray-600 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
                <svg
                    class="w-5 h-5 mr-2"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                    ></path>
                </svg>
                Zobacz kod na GitHub
            </a>
        </div>

        <!-- Features Details -->
        <div class="prose dark:prose-invert max-w-none">
            <h2 class="text-3xl font-bold mb-6">🎯 Funkcje</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose mb-8">
                <div
                    class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700"
                >
                    <h3 class="text-xl font-semibold mb-3 flex items-center">
                        <span class="text-2xl mr-3">💬</span>
                        Multi-Model Support
                    </h3>
                    <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                        <li>✓ GPT-4o (najnowszy model)</li>
                        <li>✓ GPT-4o-mini (szybszy, tańszy)</li>
                        <li>✓ GPT-3.5-turbo (klasyk)</li>
                    </ul>
                </div>

                <div
                    class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700"
                >
                    <h3 class="text-xl font-semibold mb-3 flex items-center">
                        <span class="text-2xl mr-3">⚡</span>
                        Streaming Responses
                    </h3>
                    <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                        <li>✓ Odpowiedzi słowo po słowie</li>
                        <li>✓ Niskie opóźnienia</li>
                        <li>✓ Lepsza interaktywność</li>
                    </ul>
                </div>

                <div
                    class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700"
                >
                    <h3 class="text-xl font-semibold mb-3 flex items-center">
                        <span class="text-2xl mr-3">🎭</span>
                        Role Presets
                    </h3>
                    <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                        <li>✓ Asystent (domyślny)</li>
                        <li>✓ Programista</li>
                        <li>✓ Krytyk</li>
                        <li>✓ Tłumacz</li>
                    </ul>
                </div>

                <div
                    class="bg-white dark:bg-gray-800 p-6 rounded-lg border border-gray-200 dark:border-gray-700"
                >
                    <h3 class="text-xl font-semibold mb-3 flex items-center">
                        <span class="text-2xl mr-3">💾</span>
                        Persistence & UX
                    </h3>
                    <ul class="space-y-2 text-gray-600 dark:text-gray-300">
                        <li>✓ Historia w localStorage</li>
                        <li>✓ Dark mode</li>
                        <li>✓ Mobile responsive</li>
                    </ul>
                </div>
            </div>

            <h2 class="text-3xl font-bold mb-4">🔧 Technologie</h2>
            <div class="flex flex-wrap gap-2 mb-8 not-prose">
                <span
                    class="px-3 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full text-sm font-medium"
                    >Astro</span
                >
                <span
                    class="px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-medium"
                    >React</span
                >
                <span
                    class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-full text-sm font-medium"
                    >Cloudflare Pages</span
                >
                <span
                    class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-medium"
                    >OpenAI API</span
                >
                <span
                    class="px-3 py-1 bg-pink-100 dark:bg-pink-900/30 text-pink-700 dark:text-pink-300 rounded-full text-sm font-medium"
                    >Tailwind CSS</span
                >
            </div>

            <h2 class="text-3xl font-bold mb-4">🚀 Deployment</h2>
            <div
                class="bg-gray-50 dark:bg-gray-800/50 p-6 rounded-lg border border-gray-200 dark:border-gray-700 not-prose"
            >
                <div class="space-y-3 text-sm">
                    <div class="flex items-center justify-between">
                        <span
                            class="font-medium text-gray-700 dark:text-gray-300"
                            >Main App URL:</span
                        >
                        <a
                            href={CHAT_URL}
                            target="_blank"
                            class="text-blue-600 dark:text-blue-400 hover:underline"
                            >{CHAT_URL}</a
                        >
                    </div>
                    <div class="flex items-center justify-between">
                        <span
                            class="font-medium text-gray-700 dark:text-gray-300"
                            >Worker Proxy:</span
                        >
                        <a
                            href={WORKER_PROXY_URL}
                            target="_blank"
                            class="text-blue-600 dark:text-blue-400 hover:underline"
                            >{WORKER_PROXY_URL}</a
                        >
                    </div>
                    <div class="flex items-center justify-between">
                        <span
                            class="font-medium text-gray-700 dark:text-gray-300"
                            >GitHub Repo:</span
                        >
                        <a
                            href="https://github.com/Bonzokoles/bonzo-ai-chat"
                            target="_blank"
                            class="text-blue-600 dark:text-blue-400 hover:underline"
                            >bonzo-ai-chat</a
                        >
                    </div>
                    <div class="flex items-center justify-between">
                        <span
                            class="font-medium text-gray-700 dark:text-gray-300"
                            >Status:</span
                        >
                        <span
                            class="px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded text-xs font-medium"
                            >✓ Active</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    /* Smooth iframe loading */
    #chat-iframe {
        opacity: 0;
        animation: fadeIn 0.3s ease-in forwards;
        animation-delay: 0.2s;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    /* Dark mode enhancements */
    @media (prefers-color-scheme: dark) {
        #chat-iframe {
            border-color: rgba(255, 255, 255, 0.1);
        }
    }
</style>
