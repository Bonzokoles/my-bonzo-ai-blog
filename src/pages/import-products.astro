---
title: "Import Produktów WHITECAT → D1";
description: "Migracja mapowania produktów z JSON do D1 database";
---

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold mb-4">📦 Import Produktów do D1</h1>
            <p class="text-xl text-gray-600 dark:text-gray-300">
                Migracja 2,560 produktów z WHITECAT JSON do D1 Database
            </p>
        </div>

        <!-- Status -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
            <h2 class="text-2xl font-semibold mb-4">📊 Status D1 Database</h2>
            <div id="status-container">
                <div class="animate-pulse">
                    <div class="h-4 bg-gray-300 rounded w-1/2 mb-2"></div>
                    <div class="h-4 bg-gray-300 rounded w-1/3"></div>
                </div>
            </div>
        </div>

        <!-- Import Controls -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 mb-8">
            <h3 class="text-xl font-semibold mb-4">🚀 Import Actions</h3>

            <div class="space-y-4">
                <!-- Import from WHITECAT -->
                <div class="border rounded-lg p-4">
                    <h4 class="font-semibold mb-2">Import z WHITECAT JSON</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                        Importuje wszystkie 2,560 produktów z lokalnego pliku
                        products.json
                    </p>
                    <button
                        id="import-whitecat"
                        class="bg-green-600 text-white py-2 px-4 rounded hover:bg-green-700"
                    >
                        📥 Import z WHITECAT
                    </button>
                </div>

                <!-- Verify Import -->
                <div class="border rounded-lg p-4">
                    <h4 class="font-semibold mb-2">Weryfikuj Import</h4>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                        Sprawdza czy produkty zostały poprawnie zaimportowane
                    </p>
                    <button
                        id="verify-import"
                        class="bg-blue-600 text-white py-2 px-4 rounded hover:bg-blue-700"
                    >
                        ✅ Weryfikuj
                    </button>
                </div>
            </div>
        </div>

        <!-- Results -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6">
            <h3 class="text-xl font-semibold mb-4">📄 Wyniki</h3>
            <div id="results-container">
                <p class="text-gray-500 dark:text-gray-400">
                    Kliknij jeden z przycisków powyżej aby rozpocząć.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    // Helper Functions
    async function apiCall(endpoint, options = {}) {
        try {
            const response = await fetch(endpoint, {
                ...options,
                headers: {
                    "Content-Type": "application/json",
                    ...options.headers,
                },
            });

            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}: ${response.statusText}`,
                );
            }

            return await response.json();
        } catch (error) {
            console.error("API Call failed:", error);
            throw error;
        }
    }

    function showLoading(containerId, message = "Ładowanie...") {
        const container = document.getElementById(containerId);
        container.innerHTML = `
      <div class="flex items-center space-x-2">
        <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-600"></div>
        <span class="text-blue-600">${message}</span>
      </div>
    `;
    }

    function showError(containerId, error) {
        const container = document.getElementById(containerId);
        container.innerHTML = `
      <div class="bg-red-100 dark:bg-red-900 border border-red-400 text-red-700 dark:text-red-200 px-4 py-3 rounded">
        <strong>Błąd:</strong> ${error.message || error}
      </div>
    `;
    }

    function showSuccess(containerId, message, data = null) {
        const container = document.getElementById(containerId);
        let content = `
      <div class="bg-green-100 dark:bg-green-900 border border-green-400 text-green-700 dark:text-green-200 px-4 py-3 rounded">
        <strong>✅ Sukces:</strong> ${message}
      </div>
    `;

        if (data) {
            content += `
        <div class="mt-4 bg-gray-100 dark:bg-gray-700 p-4 rounded">
          <pre class="text-sm overflow-x-auto">${JSON.stringify(data, null, 2)}</pre>
        </div>
      `;
        }

        container.innerHTML = content;
    }

    // Load Status on Page Load
    document.addEventListener("DOMContentLoaded", async () => {
        try {
            const status = await apiCall("/api/import-products");
            const container = document.getElementById("status-container");

            if (status.success) {
                const data = status.data;
                container.innerHTML = `
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
            <div class="text-center">
              <div class="text-2xl font-bold ${data.stats.totalProducts > 0 ? "text-green-600" : "text-red-600"}">${data.stats.totalProducts}</div>
              <div class="text-sm text-gray-600">Produktów</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-blue-600">${data.categories.count}</div>
              <div class="text-sm text-gray-600">Kategorii</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-purple-600">${Math.round(data.stats.avgPrice)} PLN</div>
              <div class="text-sm text-gray-600">Średnia cena</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold ${data.ready ? "text-green-600" : "text-orange-600"}">${data.ready ? "GOTOWE" : "PUSTE"}</div>
              <div class="text-sm text-gray-600">Status DB</div>
            </div>
          </div>
          <div class="text-sm text-gray-600">
            <p><strong>Database:</strong> ${data.database}</p>
            <p><strong>Zakres cen:</strong> ${data.stats.priceRange.min} - ${data.stats.priceRange.max} PLN</p>
            <p><strong>Przykład kategorii:</strong> ${data.categories.sample.slice(0, 3).join(", ")}</p>
          </div>
        `;
            }
        } catch (error) {
            console.error("Failed to load status:", error);
            showError("status-container", error);
        }
    });

    // Event Listeners
    document
        .getElementById("import-whitecat")
        .addEventListener("click", async () => {
            if (
                !confirm(
                    "Czy na pewno chcesz zaimportować produkty z WHITECAT JSON do D1? To może zająć kilka minut.",
                )
            ) {
                return;
            }

            try {
                const button = document.getElementById("import-whitecat");
                button.disabled = true;
                button.textContent = "Importowanie...";

                showLoading(
                    "results-container",
                    "Importowanie 2,560 produktów...",
                );

                const result = await apiCall("/api/import-products", {
                    method: "POST",
                    body: JSON.stringify({
                        action: "import-from-whitecat",
                    }),
                });

                if (result.success) {
                    showSuccess("results-container", result.data.message, {
                        imported: result.data.imported,
                        total: result.data.total,
                        source: result.data.source,
                    });

                    // Refresh status
                    location.reload();
                } else {
                    showError("results-container", result.error);
                }
            } catch (error) {
                showError("results-container", error);
            } finally {
                const button = document.getElementById("import-whitecat");
                button.disabled = false;
                button.textContent = "📥 Import z WHITECAT";
            }
        });

    document
        .getElementById("verify-import")
        .addEventListener("click", async () => {
            try {
                showLoading("results-container", "Weryfikacja importu...");

                const result = await apiCall("/api/import-products", {
                    method: "POST",
                    body: JSON.stringify({
                        action: "verify-import",
                    }),
                });

                if (result.success) {
                    const data = result.data;
                    showSuccess(
                        "results-container",
                        "Import zweryfikowany pomyślnie",
                        {
                            stats: data.stats,
                            categories: {
                                total: data.categoriesCount,
                                sample: data.sampleCategories,
                            },
                        },
                    );
                } else {
                    showError("results-container", result.error);
                }
            } catch (error) {
                showError("results-container", error);
            }
        });
</script>
