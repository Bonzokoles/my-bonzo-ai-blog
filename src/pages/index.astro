---
/**
 * Homepage - MyBonzo AI Blog
 * Refactored to use component-based architecture and SSR data loading
 * Reduced from 490 lines to ~150 lines (-69%)
 */
import PageHeader from "@components/Astro/PageHeader.astro";
import BlogSection from "@components/features/BlogSection.astro";
import FeaturesSection from "@components/features/FeaturesSection.astro";
import HeroSection from "@components/features/HeroSection.astro";
import Layout from "@layouts/Layout.astro";

import coverImage from "@assets/alk4.png";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Configuration imports
import {
HOMEPAGE_METADATA,
MAIN_FEATURE_CARDS,
SPEED_FEATURE_CARDS,
} from "@/config/homepage";
import { NAVIGATION_SECTIONS } from "@/config/navigation";
import { PRO_CONFIG } from "@/config/site";

// SSR data loading
import { getHomepageBlogPosts } from "@/lib/homepage-data";

// Import styles
import "@/styles/pages/index.css";

// Fetch blog posts at build time (SSR/SSG)
const blogPosts = await getHomepageBlogPosts();
---

<Layout
  title={HOMEPAGE_METADATA.title}
  description={HOMEPAGE_METADATA.description}
  class="theme-ultra"
>
  <PageHeader
    heading={HOMEPAGE_METADATA.heading}
    description={HOMEPAGE_METADATA.description}
    image={coverImage}
    imageAlt="Futurystyczny rdzeń AI - MyBonzo"
    animate={true}
  />

  <!-- Hero Section with Video + Navigation -->
  <HeroSection
    videoUrl={HOMEPAGE_METADATA.videoUrl}
    videoPoster={HOMEPAGE_METADATA.videoPoster}
    title="Witaj w MyBonzo AI Blog! Poznaj Twojego asystenta AI"
    sections={NAVIGATION_SECTIONS}
  />

  <!-- Latest Projects Section -->
  <section
    class="w-full py-16 bg-gradient-to-b from-theme-primary/5 to-transparent"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold text-theme-primary mb-4">
            🚀 Najnowsze Projekty & Osiągnięcia
          </h2>
          <p class="text-lg text-theme-primary/80 max-w-3xl mx-auto">
            Odkryj nasze najnowsze projekty AI - od optymalizacji crawlerów po generowanie obrazów
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- AI Crawler Optimization -->
          <a
            href="/.workspace_meta/notes/2026-01-19-ai-crawler-optimization.md"
            class="group bg-gray-900 border border-green-500/30 p-6 hover:border-green-500 transition-all duration-300 hover:shadow-xl hover:shadow-green-500/20"
          >
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🤖</span>
              <h3 class="text-xl font-bold text-green-400 group-hover:text-green-300">
                AI Crawler Optimization
              </h3>
            </div>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Blog repositioning + llms.txt z PURPOSE section. Perplexity, ChatGPT i Claude 
              mają teraz dostęp do 18,111 produktów z meblepumo.pl przez RAG API.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-2 py-1 bg-green-500/20 text-green-300 rounded">llms.txt</span>
              <span class="text-xs px-2 py-1 bg-green-500/20 text-green-300 rounded">robots.txt</span>
              <span class="text-xs px-2 py-1 bg-green-500/20 text-green-300 rounded">Schema.org</span>
              <span class="text-xs px-2 py-1 bg-green-500/20 text-green-300 rounded">19.01.2026</span>
            </div>
          </a>

          <!-- PUMO RAG Vector Search -->
          <a
            href="/pumo-guide/"
            class="group bg-gray-900 border border-blue-500/30 p-6 hover:border-blue-500 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/20"
          >
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🔍</span>
              <h3 class="text-xl font-bold text-blue-400 group-hover:text-blue-300">
                PUMO RAG Vector Search
              </h3>
            </div>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              768-wymiarowe embeddingi (BGE-base-en-v1.5), Cloudflare Vectorize, 
              18,111 produktów zaindeksowanych. Semantic search w {"<"}100ms.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-2 py-1 bg-blue-500/20 text-blue-300 rounded">Vectorize</span>
              <span class="text-xs px-2 py-1 bg-blue-500/20 text-blue-300 rounded">Workers AI</span>
              <span class="text-xs px-2 py-1 bg-blue-500/20 text-blue-300 rounded">Edge Computing</span>
              <span class="text-xs px-2 py-1 bg-blue-500/20 text-blue-300 rounded">v2.0</span>
            </div>
          </a>

          <!-- AI Image Generator -->
          <a
            href="#ai-image-generator"
            class="group bg-gray-900 border border-purple-500/30 p-6 hover:border-purple-500 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/20"
          >
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">🎨</span>
              <h3 class="text-xl font-bold text-purple-400 group-hover:text-purple-300">
                AI Image Generator
              </h3>
            </div>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              FREE generowanie obrazów przez Cloudflare Workers AI (SDXL). 
              10k neurons/day, wyniki w {"<"}30s, 1024x1024 PNG.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-2 py-1 bg-purple-500/20 text-purple-300 rounded">Stable Diffusion</span>
              <span class="text-xs px-2 py-1 bg-purple-500/20 text-purple-300 rounded">FREE</span>
              <span class="text-xs px-2 py-1 bg-purple-500/20 text-purple-300 rounded">10k/day</span>
              <span class="text-xs px-2 py-1 bg-purple-500/20 text-purple-300 rounded">SDXL</span>
            </div>
          </a>

          <!-- Wrangler 4.59.2 Update -->
          <div class="bg-gray-900 border border-orange-500/30 p-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl">⚡</span>
              <h3 class="text-xl font-bold text-orange-400">
                Wrangler 4.59.2
              </h3>
            </div>
            <p class="text-gray-300 text-sm leading-relaxed mb-4">
              Aktualizacja Cloudflare Wrangler CLI (3.114.17 → 4.59.2). 
              Wszystkie workers wdrożone i działają bez błędów.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="text-xs px-2 py-1 bg-orange-500/20 text-orange-300 rounded">Workers</span>
              <span class="text-xs px-2 py-1 bg-orange-500/20 text-orange-300 rounded">Deployment</span>
              <span class="text-xs px-2 py-1 bg-orange-500/20 text-orange-300 rounded">Updated</span>
              <span class="text-xs px-2 py-1 bg-orange-500/20 text-orange-300 rounded">✅ OK</span>
            </div>
          </div>
        </div>

        <!-- Stats Grid -->
        <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center p-4 bg-theme-accent/10 border border-theme-accent/30">
            <div class="text-2xl font-bold text-theme-accent mb-1">18,111</div>
            <div class="text-xs text-theme-primary/70">Products Indexed</div>
          </div>
          <div class="text-center p-4 bg-green-500/10 border border-green-500/30">
            <div class="text-2xl font-bold text-green-400 mb-1">6</div>
            <div class="text-xs text-green-300/70">AI Bots Supported</div>
          </div>
          <div class="text-center p-4 bg-purple-500/10 border border-purple-500/30">
            <div class="text-2xl font-bold text-purple-400 mb-1">FREE</div>
            <div class="text-xs text-purple-300/70">Image Generation</div>
          </div>
          <div class="text-center p-4 bg-blue-500/10 border border-blue-500/30">
            <div class="text-2xl font-bold text-blue-400 mb-1">{"<"}100ms</div>
            <div class="text-xs text-blue-300/70">API Response</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Image Generator Section - Replicate + Cloudflare -->
  <section class="w-full py-16 bg-gradient-to-b from-purple-500/5 to-blue-500/5">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-3xl lg:text-4xl font-bold bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent mb-4">
            🎨 AI Image Generator: FLUX & Stable Diffusion
          </h2>
          <p class="text-lg text-theme-primary/80 max-w-3xl mx-auto">
            Generowanie obrazów z tekstu w czasie rzeczywistym. Najnowsze modele FLUX Schnell, 
            FLUX Pro i SDXL - od $0.003 za obraz, wyniki w {"<"}60 sekund.
          </p>
        </div>

        <!-- Main Feature Grid -->
        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <!-- Image Preview -->
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-purple-500 to-blue-500 rounded-lg blur opacity-25 group-hover:opacity-40 transition duration-300"></div>
            <div class="relative bg-gray-900 border border-purple-500/30 rounded-lg overflow-hidden">
              <img 
                src="/generated/ai-search.png" 
                alt="AI-generated semantic search visualization - Cloudflare Workers AI"
                class="w-full h-auto"
              />
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-gray-900 via-gray-900/90 to-transparent p-4">
                <p class="text-sm text-purple-300">Wygenerowane przez Cloudflare Workers AI (SDXL) - FREE!</p>
              </div>
            </div>
          </div>

          <!-- Features & Tech Stack -->
          <div class="space-y-6">
            <div class="bg-gray-900 border border-purple-500/30 p-6 rounded-lg">
              <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <span class="text-2xl">⚡</span>
                Dostępne Modele
              </h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center p-3 bg-green-500/10 rounded border border-green-500/20">
                  <span class="font-semibold text-green-300">SDXL (Cloudflare)</span>
                  <span class="text-sm text-green-400 font-bold">FREE!</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-purple-500/10 rounded">
                  <span class="font-semibold text-purple-300">FLUX Schnell</span>
                  <span class="text-sm text-gray-400">$0.003/obraz</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-blue-500/10 rounded">
                  <span class="font-semibold text-blue-300">FLUX Pro</span>
                  <span class="text-sm text-gray-400">$0.055/obraz</span>
                </div>
              </div>
            </div>

            <div class="bg-gray-900 border border-blue-500/30 p-6 rounded-lg">
              <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <span class="text-2xl">🔧</span>
                Tech Stack
              </h3>
              <div class="grid grid-cols-2 gap-3">
                <div class="text-center p-3 bg-orange-500/10 border border-orange-500/20 rounded">
                  <div class="text-xl mb-1">☁️</div>
                  <div class="text-xs text-orange-300 font-semibold">Workers AI</div>
                </div>
                <div class="text-center p-3 bg-amber-500/10 border border-amber-500/20 rounded">
                  <div class="text-xl mb-1">⚡</div>
                  <div class="text-xs text-amber-300 font-semibold">Cloudflare Edge</div>
                </div>
                <div class="text-center p-3 bg-purple-500/10 border border-purple-500/20 rounded">
                  <div class="text-xl mb-1">🎯</div>
                  <div class="text-xs text-purple-300 font-semibold">Stable Diffusion</div>
                </div>
                <div class="text-center p-3 bg-blue-500/10 border border-blue-500/20 rounded">
                  <div class="text-xl mb-1">🆓</div>
                  <div class="text-xs text-blue-300 font-semibold">10k free/day</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-gray-900 border border-purple-500/30 p-6 rounded-lg">
          <div class="text-center">
            <div class="text-2xl font-bold text-green-400">FREE</div>
            <div class="text-sm text-gray-400">Cloudflare AI</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-blue-400">{"<"}30s</div>
            <div class="text-sm text-gray-400">Generowanie</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-indigo-400">1024²</div>
            <div class="text-sm text-gray-400">Rozdzielczość</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-purple-400">10k/day</div>
            <div class="text-sm text-gray-400">Limit FREE</div>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-8 text-center">
          <a 
            href="https://cf-ai-image-gen.stolarnia-ams.workers.dev/api/generate" 
            class="inline-flex items-center gap-2 px-8 py-3 bg-gradient-to-r from-green-500 to-blue-500 text-white font-semibold rounded-lg hover:from-green-600 hover:to-blue-600 transition-all duration-300 shadow-lg shadow-green-500/30 hover:shadow-xl hover:shadow-green-500/50"
          >
            <span>🎨</span>
            <span>Wypróbuj Generator (FREE!)</span>
            <span>→</span>
          </a>
          <p class="mt-4 text-sm text-gray-400">
            Powered by Cloudflare Workers AI - 
            <a href="https://developers.cloudflare.com/workers-ai/" target="_blank" class="text-green-400 hover:text-green-300 underline">
              Workers AI Docs
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Links & AI News 2025 -->
  <section
    class="w-full py-16 bg-gradient-to-b from-transparent to-theme-primary/5"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2
          class="text-3xl lg:text-4xl font-bold text-theme-primary text-center mb-12"
        >
          🌐 Nasze Projekty & AI 2025 Highlights
        </h2>

        <!-- Partner Links -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
          <a
            href="https://www.mybonzo.com"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden bg-gradient-to-br from-theme-accent/20 to-theme-primary/10 border border-theme-accent/40 p-8 hover:border-theme-accent transition-all duration-300 hover:shadow-xl hover:shadow-theme-accent/20"
          >
            <div class="flex items-center gap-4 mb-3">
              <span class="text-4xl">🏢</span>
              <h3
                class="text-2xl font-bold text-theme-primary group-hover:text-theme-accent transition-colors"
              >
                MyBonzo.com
              </h3>
            </div>
            <p class="text-theme-primary/70 leading-relaxed">
              Platforma AI dla biznesu. Rozwiązania dla e-commerce,
              automatyzacja procesów i inteligentne asystenty.
            </p>
            <div
              class="absolute bottom-3 right-3 text-theme-accent text-2xl opacity-0 group-hover:opacity-100 transition-opacity"
            >
              ↗
            </div>
          </a>

          <a
            href="https://www.zenbrowsers.org"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden bg-gradient-to-br from-purple-500/20 to-blue-500/10 border border-purple-500/40 p-8 hover:border-purple-500 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/20"
          >
            <div class="flex items-center gap-4 mb-3">
              <span class="text-4xl">🌸</span>
              <h3
                class="text-2xl font-bold text-theme-primary group-hover:text-purple-400 transition-colors"
              >
                Zen Browsers
              </h3>
            </div>
            <p class="text-theme-primary/70 leading-relaxed">
              Nowoczesne przeglądarki z wbudowaną AI. Prywatność, wydajność i
              inteligentne funkcje w jednym.
            </p>
            <div
              class="absolute bottom-3 right-3 text-purple-400 text-2xl opacity-0 group-hover:opacity-100 transition-opacity"
            >
              ↗
            </div>
          </a>
        </div>

        <!-- AI 2025 Insights -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-theme-accent text-center mb-8">
            ⚡ Przełomowe Innowacje AI w 2025
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Reasoning Models -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🧠</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Modele z Rozumowaniem
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                OpenAI o1/o3 i Claude 3.7 wprowadzają "czas myślenia" - AI teraz
                deliberuje przed odpowiedzią, osiągając 54% accuracy na
                ARC-AGI-2 (vs 0-2% rok temu).
              </p>
            </div>

            <!-- Multimodal AI -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🎨</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Multimodal AI
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                Llama 4 Scout z 10M tokenów kontekstu, Gemini 3 Flash z
                sub-millisecond latency. AI teraz natywnie łączy tekst, obraz,
                video i audio.
              </p>
            </div>

            <!-- AI Agents -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🤖</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Autonomiczne Agenty
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                62% firm eksperymentuje z AI agents, 23% skaluje production.
                Multi-agent orchestration staje się standardem enterprise.
              </p>
            </div>

            <!-- Healthcare AI -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🏥</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Medycyna & AI
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                PopEVE diagnozuje choroby genetyczne w godziny (vs lata).
                AI-auscultation wykrywa niewydolność serca 2-3x skuteczniej.
              </p>
            </div>

            <!-- Video Generation -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🎬</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                AI Video Production
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                Sora 2, Kling 2.5, Veo 3.1 - produkcyjna jakość 4K video z
                audio. 3-minutowe klipy za $8-30/miesiąc.
              </p>
            </div>

            <!-- Economic Impact -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">💰</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Wpływ Ekonomiczny
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                AI zwiększy GDP o 1.5% do 2035, 3.7% do 2075. $2T globalnych
                inwestycji w AI w 2026. 25-40% redukcja kosztów pracy.
              </p>
            </div>
          </div>

          <!-- CTA -->
          <div class="text-center mt-8">
            <a
              href="/blog/"
              class="inline-block px-8 py-4 bg-theme-accent text-white font-semibold hover:opacity-90 transition-opacity border border-gray-500"
            >
              📚 Czytaj Więcej na Blogu
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Feature Cards -->
  <FeaturesSection
    cards={MAIN_FEATURE_CARDS}
    className="mx-0 w-full flex flex-row flex-wrap-reverse justify-center gap-4 mt-14 mb-16 lg:mt-0 lg:justify-between lg:flex-nowrap lg:p-5 build-in"
  />

  <!-- AI dla Wszystkich Section -->
  <section class="flex flex-col items-center justify-center mt-6 mb-48 fade-in">
    <h2 class="graffiti-footer">AI DLA WSZYSTKICH</h2>
    <p
      class="text-xl max-w-6xl leading-relaxed text-center md:max-w-screen-lg lg:text-2xl lg:leading-relaxed"
    >
      Sztuczna inteligencja nie musi być skomplikowana. MyBonzo AI Blog łączy
      zaawansowane technologie z prostotą użytkowania, bo przyszłość powinna być
      dostępna dla każdego, niezależnie od poziomu technicznego.
    </p>
  </section>

  <!-- Speed Feature Cards -->
  <FeaturesSection
    cards={SPEED_FEATURE_CARDS}
    className="mx-0 w-full flex flex-row flex-wrap-reverse justify-center gap-4 mt-8 mb-16 lg:justify-between lg:flex-nowrap lg:p-5 build-in"
  />

  <!-- Blog Posts Section (SSR) -->
  <BlogSection posts={blogPosts} />

  <!-- Stworzone dla Ciebie Section -->
  <section class="flex flex-col items-center justify-center mt-16 mb-0 fade-in">
    <h2
      class="bg-theme-accent text-theme-secondary p-5 text-center mb-8 lg:w-auto"
    >
      Stworzone dla Ciebie
    </h2>
    <p
      class="text-2xl max-w-6xl leading-relaxed text-center md:max-w-screen-lg lg:text-2xl lg:leading-relaxed tracking-wide mt-6 mb-48"
    >
      Niezależnie od tego czy jesteś początkujący czy ekspertem, MyBonzo AI Blog
      dostarcza narzędzia i wiedzę na odpowiednim poziomie. Rozwijaj swoje
      umiejętności AI w tempie które Ci odpowiada.
    </p>
    <a href="/blog" class="no-underline group group-hover:cursor-pointer">
      <div
        class="text-xl tracking-wide bg-theme-primary text-theme-primary text-center shadow-sm shadow-theme-primary border-2 mb-4 group-hover:bg-theme-secondary group-hover:text-theme-accent group-hover:shadow-none transition-all duration-300 ease-in-out lg:text-2xl lg:tracking-wider"
