---
/**
 * Homepage - MyBonzo AI Blog
 * Refactored to use component-based architecture and SSR data loading
 * Reduced from 490 lines to ~150 lines (-69%)
 */
import PageHeader from "@components/Astro/PageHeader.astro";
import BlogSection from "@components/features/BlogSection.astro";
import FeaturesSection from "@components/features/FeaturesSection.astro";
import HeroSection from "@components/features/HeroSection.astro";
import Layout from "@layouts/Layout.astro";

import coverImage from "@assets/alk4.png";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Configuration imports
import {
HOMEPAGE_METADATA,
MAIN_FEATURE_CARDS,
SPEED_FEATURE_CARDS,
} from "@/config/homepage";
import { NAVIGATION_SECTIONS } from "@/config/navigation";
import { PRO_CONFIG } from "@/config/site";

// SSR data loading
import { getHomepageBlogPosts } from "@/lib/homepage-data";

// Import styles
import "@/styles/pages/index.css";

// Fetch blog posts at build time (SSR/SSG)
const blogPosts = await getHomepageBlogPosts();
---

<Layout
  title={HOMEPAGE_METADATA.title}
  description={HOMEPAGE_METADATA.description}
  class="theme-ultra"
>
  <PageHeader
    heading={HOMEPAGE_METADATA.heading}
    description={HOMEPAGE_METADATA.description}
    image={coverImage}
    imageAlt="Futurystyczny rdzeń AI - MyBonzo"
    animate={true}
  />

  <!-- Hero Section with Video + Navigation -->
  <HeroSection
    videoUrl={HOMEPAGE_METADATA.videoUrl}
    videoPoster={HOMEPAGE_METADATA.videoPoster}
    title="Witaj w MyBonzo AI Blog! Poznaj Twojego asystenta AI"
    sections={NAVIGATION_SECTIONS}
  />

  <!-- Meble Pumo RAG Feature - Cloudflare Vectorize -->
  <section
    class="w-full py-16 bg-gradient-to-b from-theme-primary/5 to-transparent"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto text-center mb-8">
        <h2 class="text-3xl lg:text-4xl font-bold text-theme-primary mb-4">
          🚀 PUMO RAG v2.0: Vector Search z Cloudflare AI
        </h2>
        <p class="text-lg text-theme-primary/80 max-w-3xl mx-auto">
          Nowa generacja wyszukiwania semantycznego: 768-wymiarowe embeddingi, 
          Cloudflare Vectorize, Workers AI - wyszukaj meble używając naturalnego języka 
          wśród 13,388 produktów w czasie rzeczywistym.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <!-- Live Search Demo -->
        <div class="bg-gray-900 border border-theme-accent/30 shadow-2xl shadow-theme-accent/20 p-8">
          <h3 class="text-2xl font-bold text-white mb-4">🔍 Live Semantic Search Demo</h3>
          <p class="text-gray-300 mb-6">Wpisz zapytanie po polsku, np. "wygodna sofa do salonu" lub "biurko dla gracza"</p>
          
          <div class="flex gap-4 mb-6">
            <input 
              type="text" 
              id="searchInput" 
              placeholder="Szukaj mebli..."
              class="flex-1 px-4 py-3 bg-gray-800 border border-theme-accent/50 text-white placeholder-gray-500 focus:outline-none focus:border-theme-accent"
            />
            <button 
              id="searchButton"
              class="px-6 py-3 bg-theme-accent text-white font-semibold hover:opacity-90 transition-opacity"
            >
              Szukaj
            </button>
          </div>
          
          <div id="searchResults" class="space-y-4"></div>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a
            href="/pumo-guide/"
            class="px-6 py-3 bg-theme-accent text-white font-semibold hover:opacity-90 transition-opacity border border-gray-500"
          >
            📚 Zobacz 66 Przewodników AI Meble Pumo
          </a>
          <a
            href="https://pumo-rag.stolarnia-ams.workers.dev/api/search"
            target="_blank"
            class="px-6 py-3 bg-transparent text-theme-primary border border-theme-accent font-semibold hover:bg-theme-accent hover:text-white transition-colors"
          >
            🔍 API: Semantic Search (POST)
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="px-6 py-3 bg-transparent text-theme-primary border border-theme-accent font-semibold hover:bg-theme-accent hover:text-white transition-colors"
          >
            🤖 Dokumentacja dla AI Crawlerów
          </a>
        </div>

        <!-- Tech Stack Features -->
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-theme-primary/5 p-6 border border-theme-accent/20">
            <div class="text-4xl mb-4">⚡</div>
            <h4 class="text-xl font-bold text-theme-primary mb-2">Cloudflare Workers</h4>
            <p class="text-sm text-theme-primary/70">
              Edge computing - API działa w 310 lokalizacjach globalnie z sub-100ms latency
            </p>
          </div>

          <div class="bg-theme-primary/5 p-6 border border-theme-accent/20">
            <div class="text-4xl mb-4">🧠</div>
            <h4 class="text-xl font-bold text-theme-primary mb-2">Workers AI</h4>
            <p class="text-sm text-theme-primary/70">
              Model BGE-base-en-v1.5 (768d) - embeddingi generowane on-the-fly bez cold starts
            </p>
          </div>

          <div class="bg-theme-primary/5 p-6 border border-theme-accent/20">
            <div class="text-4xl mb-4">🗄️</div>
            <h4 class="text-xl font-bold text-theme-primary mb-2">Vectorize</h4>
            <p class="text-sm text-theme-primary/70">
              13,388 wektorów produktów z cosine similarity search - znalezienie w ms
            </p>
          </div>
        </div>
      </div>

      <!-- Stats Section -->
      <div
        class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto"
      >
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">13,388</div>
          <div class="text-sm text-theme-primary/70">
            Produktów w Vectorize
          </div>
        </div>
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">768</div>
          <div class="text-sm text-theme-primary/70">
            Wymiarów Embeddings
          </div>
        </div>
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">&lt;100ms</div>
          <div class="text-sm text-theme-primary/70">Czas Odpowiedzi API</div>
        </div>
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">∞</div>
          <div class="text-sm text-theme-primary/70">
            Skalowalność (Workers)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Links & AI News 2025 -->
  <section
    class="w-full py-16 bg-gradient-to-b from-transparent to-theme-primary/5"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2
          class="text-3xl lg:text-4xl font-bold text-theme-primary text-center mb-12"
        >
          🌐 Nasze Projekty & AI 2025 Highlights
        </h2>

        <!-- Partner Links -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
          <a
            href="https://www.mybonzo.com"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden bg-gradient-to-br from-theme-accent/20 to-theme-primary/10 border border-theme-accent/40 p-8 hover:border-theme-accent transition-all duration-300 hover:shadow-xl hover:shadow-theme-accent/20"
          >
            <div class="flex items-center gap-4 mb-3">
              <span class="text-4xl">🏢</span>
              <h3
                class="text-2xl font-bold text-theme-primary group-hover:text-theme-accent transition-colors"
              >
                MyBonzo.com
              </h3>
            </div>
            <p class="text-theme-primary/70 leading-relaxed">
              Platforma AI dla biznesu. Rozwiązania dla e-commerce,
              automatyzacja procesów i inteligentne asystenty.
            </p>
            <div
              class="absolute bottom-3 right-3 text-theme-accent text-2xl opacity-0 group-hover:opacity-100 transition-opacity"
            >
              ↗
            </div>
          </a>

          <a
            href="https://www.zenbrowsers.org"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden bg-gradient-to-br from-purple-500/20 to-blue-500/10 border border-purple-500/40 p-8 hover:border-purple-500 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/20"
          >
            <div class="flex items-center gap-4 mb-3">
              <span class="text-4xl">🌸</span>
              <h3
                class="text-2xl font-bold text-theme-primary group-hover:text-purple-400 transition-colors"
              >
                Zen Browsers
              </h3>
            </div>
            <p class="text-theme-primary/70 leading-relaxed">
              Nowoczesne przeglądarki z wbudowaną AI. Prywatność, wydajność i
              inteligentne funkcje w jednym.
            </p>
            <div
              class="absolute bottom-3 right-3 text-purple-400 text-2xl opacity-0 group-hover:opacity-100 transition-opacity"
            >
              ↗
            </div>
          </a>
        </div>

        <!-- AI 2025 Insights -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-theme-accent text-center mb-8">
            ⚡ Przełomowe Innowacje AI w 2025
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Reasoning Models -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🧠</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Modele z Rozumowaniem
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                OpenAI o1/o3 i Claude 3.7 wprowadzają "czas myślenia" - AI teraz
                deliberuje przed odpowiedzią, osiągając 54% accuracy na
                ARC-AGI-2 (vs 0-2% rok temu).
              </p>
            </div>

            <!-- Multimodal AI -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🎨</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Multimodal AI
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                Llama 4 Scout z 10M tokenów kontekstu, Gemini 3 Flash z
                sub-millisecond latency. AI teraz natywnie łączy tekst, obraz,
                video i audio.
              </p>
            </div>

            <!-- AI Agents -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🤖</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Autonomiczne Agenty
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                62% firm eksperymentuje z AI agents, 23% skaluje production.
                Multi-agent orchestration staje się standardem enterprise.
              </p>
            </div>

            <!-- Healthcare AI -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🏥</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Medycyna & AI
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                PopEVE diagnozuje choroby genetyczne w godziny (vs lata).
                AI-auscultation wykrywa niewydolność serca 2-3x skuteczniej.
              </p>
            </div>

            <!-- Video Generation -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">🎬</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                AI Video Production
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                Sora 2, Kling 2.5, Veo 3.1 - produkcyjna jakość 4K video z
                audio. 3-minutowe klipy za $8-30/miesiąc.
              </p>
            </div>

            <!-- Economic Impact -->
            <div
              class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all"
            >
              <div class="text-3xl mb-3">💰</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">
                Wpływ Ekonomiczny
              </h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                AI zwiększy GDP o 1.5% do 2035, 3.7% do 2075. $2T globalnych
                inwestycji w AI w 2026. 25-40% redukcja kosztów pracy.
              </p>
            </div>
          </div>

          <!-- CTA -->
          <div class="text-center mt-8">
            <a
              href="/blog/"
              class="inline-block px-8 py-4 bg-theme-accent text-white font-semibold hover:opacity-90 transition-opacity border border-gray-500"
            >
              📚 Czytaj Więcej na Blogu
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Feature Cards -->
  <FeaturesSection
    cards={MAIN_FEATURE_CARDS}
    className="mx-0 w-full flex flex-row flex-wrap-reverse justify-center gap-4 mt-14 mb-16 lg:mt-0 lg:justify-between lg:flex-nowrap lg:p-5 build-in"
  />

  <!-- AI dla Wszystkich Section -->
  <section class="flex flex-col items-center justify-center mt-6 mb-48 fade-in">
    <h2 class="graffiti-footer">AI DLA WSZYSTKICH</h2>
    <p
      class="text-xl max-w-6xl leading-relaxed text-center md:max-w-screen-lg lg:text-2xl lg:leading-relaxed"
    >
      Sztuczna inteligencja nie musi być skomplikowana. MyBonzo AI Blog łączy
      zaawansowane technologie z prostotą użytkowania, bo przyszłość powinna być
      dostępna dla każdego, niezależnie od poziomu technicznego.
    </p>
  </section>

  <!-- Speed Feature Cards -->
  <FeaturesSection
    cards={SPEED_FEATURE_CARDS}
    className="mx-0 w-full flex flex-row flex-wrap-reverse justify-center gap-4 mt-8 mb-16 lg:justify-between lg:flex-nowrap lg:p-5 build-in"
  />

  <!-- Blog Posts Section (SSR) -->
  <BlogSection posts={blogPosts} />

  <!-- Stworzone dla Ciebie Section -->
  <section class="flex flex-col items-center justify-center mt-16 mb-0 fade-in">
    <h2
      class="bg-theme-accent text-theme-secondary p-5 text-center mb-8 lg:w-auto"
    >
      Stworzone dla Ciebie
    </h2>
    <p
      class="text-2xl max-w-6xl leading-relaxed text-center md:max-w-screen-lg lg:text-2xl lg:leading-relaxed tracking-wide mt-6 mb-48"
    >
      Niezależnie od tego czy jesteś początkujący czy ekspertem, MyBonzo AI Blog
      dostarcza narzędzia i wiedzę na odpowiednim poziomie. Rozwijaj swoje
      umiejętności AI w tempie które Ci odpowiada.
    </p>
    <a href="/blog" class="no-underline group group-hover:cursor-pointer">
      <div
        class="text-xl tracking-wide bg-theme-primary text-theme-primary text-center shadow-sm shadow-theme-primary border-2 mb-4 group-hover:bg-theme-secondary group-hover:text-theme-accent group-hover:shadow-none transition-all duration-300 ease-in-out lg:text-2xl lg:tracking-wider"
      >
        <div class="mt-0">
          <Icon name="ri:article-line" height="150" width="300" class="mb-5" />
          <p class="p-4 group-hover:text-theme-accent">Rozpocznij Czytanie</p>
        </div>
      </div>
    </a>
  </section>

  <!-- AI Empowerment Image -->
  <section class="flex flex-col items-center justify-center mt-6">
    <div class="w-full mb-8 flex justify-center">
      <img
        src="/AI_News_ZenBrowsers.png"
        alt="Let AI empower your work - Modern AI tools transforming productivity and creativity in 2026"
        class="shadow-md shadow-theme-primary max-w-4xl rounded-lg"
        loading="lazy"
        width="1200"
        height="630"
      />
    </div>
  </section>

  <!-- MyBonzo Pro CTA -->
  <section style="margin-top:2.5em; text-align:center; padding: 2rem 0;">
    <div class="container mx-auto px-4">
      <p class="text-lg">
        <strong>{PRO_CONFIG.ctaText}</strong>
        <a
          href={PRO_CONFIG.ctaUrl}
          style="color:#2a6de9; text-decoration:underline; font-weight: 600;"
        >
          {PRO_CONFIG.ctaLinkText}
        </a>
      </p>
    </div>
  </section>

  <!-- Search Script -->
  <script>
    const searchButton = document.getElementById('searchButton');
    const searchInput = document.getElementById('searchInput');
    const searchResults = document.getElementById('searchResults');

    async function performSearch() {
      const query = searchInput?.value.trim();
      if (!query || !searchResults) return;

      searchResults.innerHTML = '<div class="text-gray-400 text-center py-8">🔍 Wyszukiwanie...</div>';
      
      try {
        const response = await fetch('https://pumo-rag.stolarnia-ams.workers.dev/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query, limit: 5 })
        });
        
        if (!response.ok) throw new Error('Search failed');
        
        const data = await response.json();
        
        if (data.results && data.results.length > 0) {
          searchResults.innerHTML = data.results.map((product, i) => `
            <div class="bg-gray-800 border border-theme-accent/30 p-4 hover:border-theme-accent/60 transition-colors">
              <div class="flex justify-between items-start mb-2">
                <h4 class="text-white font-semibold flex-1">${product.name}</h4>
                <span class="text-xs text-theme-accent ml-2">Score: ${(product.score * 100).toFixed(1)}%</span>
              </div>
              <p class="text-gray-400 text-sm mb-2">${product.category || 'Meble'}</p>
              ${product.price ? `<p class="text-theme-accent font-bold">${product.price} PLN</p>` : ''}
              ${product.url ? `<a href="${product.url}" target="_blank" class="text-xs text-blue-400 hover:underline">Zobacz produkt ↗</a>` : ''}
            </div>
          `).join('');
        } else {
          searchResults.innerHTML = '<div class="text-gray-400 text-center py-8">Brak wyników</div>';
        }
      } catch (error) {
        searchResults.innerHTML = '<div class="text-red-400 text-center py-8">❌ Błąd wyszukiwania. Spróbuj ponownie.</div>';
        console.error('Search error:', error);
      }
    }

    searchButton?.addEventListener('click', performSearch);
    searchInput?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') performSearch();
    });
  </script>

  <!-- PUMO AI Dataset Schema for Crawlers -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Dataset",
    "name": "Meble Pumo RAG Vector Database",
    "description": "768-dimensional vector database with 13,388 furniture products from Meble Pumo, powered by Cloudflare Vectorize and Workers AI for semantic search.",
    "url": "https://mybonzoaiblog.pages.dev/pumo-guide",
    "creator": {
        "@type": "Organization",
        "name": "MyBonzo AI"
    },
    "distribution": [
        {
            "@type": "DataDownload",
            "encodingFormat": "application/json",
            "contentUrl": "https://pumo-rag.stolarnia-ams.workers.dev/api/search"
        }
    ],
    "isAccessibleForFree": true,
    "datePublished": "2026-01-18",
    "keywords": ["furniture", "vectors", "embeddings", "RAG", "AI", "Meble Pumo", "ecommerce", "Cloudflare", "Vectorize"]
  })} />
</Layout>
