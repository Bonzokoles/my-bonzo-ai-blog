---
/**
 * Homepage - MyBonzo AI Blog
 * Refactored to use component-based architecture and SSR data loading
 * Reduced from 490 lines to ~150 lines (-69%)
 */
import PageHeader from "@components/Astro/PageHeader.astro";
import BlogSection from "@components/features/BlogSection.astro";
import FeaturesSection from "@components/features/FeaturesSection.astro";
import HeroSection from "@components/features/HeroSection.astro";
import Layout from "@layouts/Layout.astro";

import coverImage from "@assets/alk-cover-2.webp";
import Bing from "@assets/bing.jpg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

// Configuration imports
import {
  HOMEPAGE_METADATA,
  MAIN_FEATURE_CARDS,
  SPEED_FEATURE_CARDS,
} from "@/config/homepage";
import { NAVIGATION_SECTIONS } from "@/config/navigation";
import { PRO_CONFIG } from "@/config/site";

// SSR data loading
import { getHomepageBlogPosts } from "@/lib/homepage-data";

// Import styles
import "@/styles/pages/index.css";

// Fetch blog posts at build time (SSR/SSG)
const blogPosts = await getHomepageBlogPosts();

// Theme options
const options = {
  "rounded-theme": true,
};
---

<Layout
  title={HOMEPAGE_METADATA.title}
  description={HOMEPAGE_METADATA.description}
>
  <PageHeader
    heading={HOMEPAGE_METADATA.heading}
    description={HOMEPAGE_METADATA.description}
    image={coverImage}
    imageAlt="MyBonzo AI Blog - centrum wiedzy o sztucznej inteligencji"
    backgroundPattern="M20.3 29.35l-3.1-3.2-3.55 3.55-3.55-3.55 3.55-3.55 3.55 3.55L31.35 12 27.8 8.45l-3.55 3.55 3.55 3.55L30.9 18.65l-3.35 3.6L20.75 15.55l3.55-3.55L17.2 4.95 20.7 1.3l3.55 3.6L20.75 8.45 17.2 12l-7.45-7.45L13.35.9l3.85 4.05-3.55 3.55-3.55 3.55 3.55 3.55-3.55 3.55-3.55-3.55-3.9-3.9 3.55-3.55L13.65 15.55l-3.55-3.55L3.05 19.1l3.55 3.55L13.65 15.55l-3.55 3.55 3.55 3.55 3.55-3.55L23.75 25.8l.05.05-3.5 3.5"
    animate={true}
  />

  <!-- Hero Section with Video + Navigation -->
  <HeroSection
    videoUrl={HOMEPAGE_METADATA.videoUrl}
    videoPoster={HOMEPAGE_METADATA.videoPoster}
    title="Witaj w MyBonzo AI Blog! Poznaj Twojego asystenta AI"
    sections={NAVIGATION_SECTIONS}
  />

  <!-- Meble Pumo Feature Video (WHITECAT Generated) -->
  <section
    class="w-full py-16 bg-gradient-to-b from-theme-primary/5 to-transparent"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto text-center mb-8">
        <h2 class="text-3xl lg:text-4xl font-bold text-theme-primary mb-4">
          🎬 WHITECAT v1.0 w Akcji: Meble Pumo AI Assistant
        </h2>
        <p class="text-lg text-theme-primary/80 max-w-3xl mx-auto">
          Zobacz jak nasz system WHITECAT (3-layer MOA: DeepSeek + Claude +
          GPT-4) generuje inteligentne odpowiedzi dla 2500 produktów Meble Pumo
          w czasie rzeczywistym.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div
          class="relative aspect-video bg-gray-900 border border-theme-accent/30 shadow-2xl shadow-theme-accent/20"
        >
          <video
            id="pumoPresentationVideo"
            class="w-full h-full object-contain"
            controls
            preload="metadata"
          >
            <source
              src="https://pub-ec47f213b171463d9502f5562213f837.r2.dev/Agent_video_Pippit_20251231072136.mp4"
              type="video/mp4"
            />
            Twoja przeglądarka nie obsługuje odtwarzania wideo HTML5.
          </video>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a
            href="/pumo-guide/"
            class="px-6 py-3 bg-theme-accent text-white font-semibold hover:opacity-90 transition-opacity border border-gray-500"
          >
            📚 Zobacz 63 Przewodniki Meble Pumo
          </a>
          <a
            href="/blog/whitecat-case-study-roi-2025/"
            class="px-6 py-3 bg-transparent text-theme-primary border border-theme-accent font-semibold hover:bg-theme-accent hover:text-white transition-colors"
          >
            📊 Case Study: ROI 54x
          </a>
          <a
            href="/blog/rag-moa-ecommerce-2025/"
            class="px-6 py-3 bg-transparent text-theme-primary border border-theme-accent font-semibold hover:bg-theme-accent hover:text-white transition-colors"
          >
            🔬 Jak Działa 3-Layer MOA
          </a>
        </div>

        <!-- Additional Videos Grid -->
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-theme-primary/5 p-4 border border-theme-accent/20">
            <video
              class="w-full aspect-video object-cover mb-3"
              controls
              preload="none"
            >
              <source
                src="https://pub-ec47f213b171463d9502f5562213f837.r2.dev/Poprawka_i_gotowe_wideo.mp4"
                type="video/mp4"
              />
            </video>
            <p class="text-sm text-theme-primary/70 text-center">
              Demo: Poprawki AI w czasie rzeczywistym
            </p>
          </div>

          <div class="bg-theme-primary/5 p-4 border border-theme-accent/20">
            <video
              class="w-full aspect-video object-cover mb-3"
              controls
              preload="none"
            >
              <source
                src="https://pub-ec47f213b171463d9502f5562213f837.r2.dev/videonr333.mp4"
                type="video/mp4"
              />
            </video>
            <p class="text-sm text-theme-primary/70 text-center">
              Video #333: Advanced Features
            </p>
          </div>

          <div class="bg-theme-primary/5 p-4 border border-theme-accent/20">
            <video
              class="w-full aspect-video object-cover mb-3"
              controls
              preload="none"
            >
              <source
                src="https://pub-ec47f213b171463d9502f5562213f837.r2.dev/202512310711.mp4"
                type="video/mp4"
              />
            </video>
            <p class="text-sm text-theme-primary/70 text-center">
              Quick Demo: System Overview
            </p>
          </div>
        </div>
      </div>

      <!-- Stats Section -->
      <div
        class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto"
      >
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">2500</div>
          <div class="text-sm text-theme-primary/70">
            Produktów Przetworzonych
          </div>
        </div>
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">24h</div>
          <div class="text-sm text-theme-primary/70">
            Czas Generacji (vs 180h)
          </div>
        </div>
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">68%</div>
          <div class="text-sm text-theme-primary/70">AI Citation Rate</div>
        </div>
        <div
          class="text-center p-6 bg-theme-accent/10 border border-theme-accent/30"
        >
          <div class="text-3xl font-bold text-theme-accent mb-2">54x</div>
          <div class="text-sm text-theme-primary/70">
            ROI (500 vs 27,800 PLN)
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Links & AI News 2025 -->
  <section
    class="w-full py-16 bg-gradient-to-b from-transparent to-theme-primary/5"
  >
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-bold text-theme-primary text-center mb-12">
          🌐 Nasze Projekty & AI 2025 Highlights
        </h2>

        <!-- Partner Links -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
          <a
            href="https://www.mybonzo.com"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden bg-gradient-to-br from-theme-accent/20 to-theme-primary/10 border border-theme-accent/40 p-8 hover:border-theme-accent transition-all duration-300 hover:shadow-xl hover:shadow-theme-accent/20"
          >
            <div class="flex items-center gap-4 mb-3">
              <span class="text-4xl">🏢</span>
              <h3 class="text-2xl font-bold text-theme-primary group-hover:text-theme-accent transition-colors">
                MyBonzo.com
              </h3>
            </div>
            <p class="text-theme-primary/70 leading-relaxed">
              Platforma AI dla biznesu. Rozwiązania dla e-commerce, automatyzacja procesów i inteligentne asystenty.
            </p>
            <div class="absolute bottom-3 right-3 text-theme-accent opacity-0 group-hover:opacity-100 transition-opacity">
              <Icon name="mdi:arrow-top-right" class="w-6 h-6" />
            </div>
          </a>

          <a
            href="https://www.zenbrowsers.org"
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden bg-gradient-to-br from-purple-500/20 to-blue-500/10 border border-purple-500/40 p-8 hover:border-purple-500 transition-all duration-300 hover:shadow-xl hover:shadow-purple-500/20"
          >
            <div class="flex items-center gap-4 mb-3">
              <span class="text-4xl">🌸</span>
              <h3 class="text-2xl font-bold text-theme-primary group-hover:text-purple-400 transition-colors">
                Zen Browsers
              </h3>
            </div>
            <p class="text-theme-primary/70 leading-relaxed">
              Nowoczesne przeglądarki z wbudowaną AI. Prywatność, wydajność i inteligentne funkcje w jednym.
            </p>
            <div class="absolute bottom-3 right-3 text-purple-400 opacity-0 group-hover:opacity-100 transition-opacity">
              <Icon name="mdi:arrow-top-right" class="w-6 h-6" />
            </div>
          </a>
        </div>

        <!-- AI 2025 Insights -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-theme-accent text-center mb-8">
            ⚡ Przełomowe Innowacje AI w 2025
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Reasoning Models -->
            <div class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all">
              <div class="text-3xl mb-3">🧠</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">Modele z Rozumowaniem</h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                OpenAI o1/o3 i Claude 3.7 wprowadzają "czas myślenia" - AI teraz deliberuje przed odpowiedzią, osiągając 54% accuracy na ARC-AGI-2 (vs 0-2% rok temu).
              </p>
            </div>

            <!-- Multimodal AI -->
            <div class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all">
              <div class="text-3xl mb-3">🎨</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">Multimodal AI</h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                Llama 4 Scout z 10M tokenów kontekstu, Gemini 3 Flash z sub-millisecond latency. AI teraz natywnie łączy tekst, obraz, video i audio.
              </p>
            </div>

            <!-- AI Agents -->
            <div class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all">
              <div class="text-3xl mb-3">🤖</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">Autonomiczne Agenty</h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                62% firm eksperymentuje z AI agents, 23% skaluje production. Multi-agent orchestration staje się standardem enterprise.
              </p>
            </div>

            <!-- Healthcare AI -->
            <div class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all">
              <div class="text-3xl mb-3">🏥</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">Medycyna & AI</h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                PopEVE diagnozuje choroby genetyczne w godziny (vs lata). AI-auscultation wykrywa niewydolność serca 2-3x skuteczniej.
              </p>
            </div>

            <!-- Video Generation -->
            <div class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all">
              <div class="text-3xl mb-3">🎬</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">AI Video Production</h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                Sora 2, Kling 2.5, Veo 3.1 - produkcyjna jakość 4K video z audio. 3-minutowe klipy za $8-30/miesiąc.
              </p>
            </div>

            <!-- Economic Impact -->
            <div class="bg-theme-primary/5 border border-theme-accent/30 p-6 hover:border-theme-accent/60 transition-all">
              <div class="text-3xl mb-3">💰</div>
              <h4 class="text-lg font-semibold text-theme-primary mb-2">Wpływ Ekonomiczny</h4>
              <p class="text-sm text-theme-primary/70 leading-relaxed">
                AI zwiększy GDP o 1.5% do 2035, 3.7% do 2075. $2T globalnych inwestycji w AI w 2026. 25-40% redukcja kosztów pracy.
              </p>
            </div>
          </div>

          <!-- CTA -->
          <div class="text-center mt-8">
            <a
              href="/blog/"
              class="inline-block px-8 py-4 bg-theme-accent text-white font-semibold hover:opacity-90 transition-opacity border border-gray-500"
            >
              📚 Czytaj Więcej na Blogu
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Feature Cards -->
  <FeaturesSection
    cards={MAIN_FEATURE_CARDS}
    className="mx-0 w-full flex flex-row flex-wrap-reverse justify-center gap-4 mt-14 mb-16 lg:mt-0 lg:justify-between lg:flex-nowrap lg:p-5 build-in"
  />

  <!-- AI dla Wszystkich Section -->
  <section class="flex flex-col items-center justify-center mt-6 mb-48 fade-in">
    <h2 class="graffiti-footer">AI DLA WSZYSTKICH</h2>
    <p
      class="text-xl max-w-6xl leading-relaxed text-center md:max-w-screen-lg lg:text-2xl lg:leading-relaxed"
    >
      Sztuczna inteligencja nie musi być skomplikowana. MyBonzo AI Blog łączy
      zaawansowane technologie z prostotą użytkowania, bo przyszłość powinna być
      dostępna dla każdego, niezależnie od poziomu technicznego.
    </p>
  </section>

  <!-- Speed Feature Cards -->
  <FeaturesSection
    cards={SPEED_FEATURE_CARDS}
    className="mx-0 w-full flex flex-row flex-wrap-reverse justify-center gap-4 mt-8 mb-16 lg:justify-between lg:flex-nowrap lg:p-5 build-in"
  />

  <!-- Blog Posts Section (SSR) -->
  <BlogSection posts={blogPosts} />

  <!-- Stworzone dla Ciebie Section -->
  <section class="flex flex-col items-center justify-center mt-16 mb-0 fade-in">
    <h2
      class:list={[
        "bg-theme-accent text-theme-secondary p-5 text-center mb-8 lg:w-auto",
        options,
      ]}
    >
      Stworzone dla Ciebie
    </h2>
    <p
      class="text-2xl max-w-6xl leading-relaxed text-center md:max-w-screen-lg lg:text-2xl lg:leading-relaxed tracking-wide mt-6 mb-48"
    >
      Niezależnie od tego czy jesteś początkujący czy ekspertem, MyBonzo AI Blog
      dostarcza narzędzia i wiedzę na odpowiednim poziomie. Rozwijaj swoje
      umiejętności AI w tempie które Ci odpowiada.
    </p>
    <a href="/blog" class="no-underline group group-hover:cursor-pointer">
      <div
        class:list={[
          "text-xl tracking-wide bg-theme-primary text-theme-primary text-center shadow-sm shadow-theme-primary border-2 mb-4 group-hover:bg-theme-secondary group-hover:text-theme-accent group-hover:shadow-none transition-all duration-300 ease-in-out lg:text-2xl lg:tracking-wider",
          options,
        ]}
      >
        <div class="mt-0">
          <Icon name="ri:article-line" height="150" width="300" class="mb-5" />
          <p class="p-4 group-hover:text-theme-accent">Rozpocznij Czytanie</p>
        </div>
      </div>
    </a>
  </section>

  <!-- Chandler Bing Quote Image -->
  <section class="flex flex-col items-center justify-center mt-6">
    <div class="w-full mb-8 flex justify-center">
      <Image
        src={Bing}
        alt="a quote from Chandler Bing from Friends. Hard work never killed anybody, but why take a chance?"
        class:list={["shadow-md shadow-theme-primary", options]}
        loading="lazy"
        width={750}
        format="webp"
      />
    </div>
  </section>

  <!-- MyBonzo Pro CTA -->
  <section style="margin-top:2.5em; text-align:center; padding: 2rem 0;">
    <div class="container mx-auto px-4">
      <p class="text-lg">
        <strong>{PRO_CONFIG.ctaText}</strong>
        <a
          href={PRO_CONFIG.ctaUrl}
          style="color:#2a6de9; text-decoration:underline; font-weight: 600;"
        >
          {PRO_CONFIG.ctaLinkText}
        </a>
      </p>
    </div>
  </section>
</Layout>
