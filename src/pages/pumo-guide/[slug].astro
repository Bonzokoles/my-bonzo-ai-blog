---
import Layout from "../../layouts/PumoGuideLayout.astro";

export const prerender = false;

const { slug } = Astro.params;
const { DB } = Astro.locals.runtime.env;

let content = {
  type: 'category', // or 'product'
  title: '',
  description: '',
  data: null as any
};

try {
  if (!DB) throw new Error("Database not available");

  // 1. Try to find a category with this slug
  const categoryResult = await DB.prepare("SELECT * FROM categories WHERE slug = ?").bind(slug).first();

  if (categoryResult) {
    content.type = 'category';
    content.title = categoryResult.name;
    content.description = categoryResult.description || `Przewodnik po kategorii ${categoryResult.name}`;
    
    // Fetch products in this category
    const productsResult = await DB.prepare(
      "SELECT * FROM products WHERE category_id = ? AND status = 'active'"
    ).bind(categoryResult.id).all();
    
    content.data = {
      category: categoryResult,
      products: productsResult.results
    };
  } else {
    // 2. Try to find a product with this slug (assuming slug logic matches or we change routing)
    // For now, let's assume direct mapping if no category found, OR return 404
    // Actually, existing structure uses /pumo-guide/[slug].md for categories.
    // If we want product details, it might be /pumo-guide/products/[id].
    // Let's stick to Category logic for [slug] to match legacy behavior.
    
    return Astro.redirect('/404');
  }

} catch (e) {
  console.error(e);
  // Fallback? Or just error page
}

if (!content.data) {
    return Astro.redirect('/404');
}

const { category, products } = content.data;

---

<Layout title={content.title} description={content.description} category={category.name}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-bold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600">
        {category.name}
      </h1>
      <p class="text-xl text-gray-500 max-w-2xl mx-auto">{category.description}</p>
    </div>

    {products.length === 0 ? (
      <div class="text-center p-12 bg-gray-50 rounded-xl">
        <p class="text-gray-500">Brak produktów w tej kategorii (jeszcze).</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {products.map((p: any) => (
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition p-6 border dark:border-gray-700">
            <h2 class="text-xl font-bold mb-2">{p.name}</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-2">{p.description}</p>
            <div class="flex justify-between items-center mt-4">
               <span class="text-2xl font-bold text-blue-600">{p.price} PLN</span>
               <a href={`/pumo-guide/products/${p.external_id}`} class="text-blue-500 hover:text-blue-700 font-medium">
                 Szczegóły →
               </a>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
