---
import Layout from "../../layouts/PumoGuideLayout.astro";

// Enable SSR for this route to fetch from D1
export const prerender = false;

const { DB } = Astro.locals.runtime.env;

let data = [];
let error = null;
let debugInfo = {};

try {
  if (!DB) {
    throw new Error("Database binding (DB) not available in Astro.locals.runtime.env");
  }

  // Debug: Check table existence
  const tables = await DB.prepare("SELECT name FROM sqlite_master WHERE type='table'").all();
  debugInfo.tables = tables.results;

  // Fetch products
  const { results } = await DB.prepare("SELECT * FROM products").all();
  data = results;
} catch (e) {
  console.error(e);
  error = e.message;
  debugInfo.errorStack = e.stack;
}

const title = "Dynamic Pumo Guide (D1 Source)";
---

<Layout title={title} category="Dynamic" subcategory="D1 Source">
  <div class="prose max-w-none p-4 dark:text-gray-100">
    <h1 class="text-3xl font-bold mb-4">🛡️ Dynamic Pumo Guide</h1>
    <p class="text-gray-500 mb-8">Serving live data from Cloudflare D1</p>

    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
        <strong class="font-bold">Database Error:</strong>
        <span class="block sm:inline">{error}</span>
        <pre class="text-xs mt-2 overflow-auto max-h-40 bg-red-50 p-2 rounded">{debugInfo.errorStack}</pre>
      </div>
    )}

    {debugInfo.tables && (
      <div class="mb-8">
        <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-2">Database Tables</h3>
        <div class="flex gap-2">
          {debugInfo.tables.map((t: any) => (
             <span class="px-2 py-1 bg-gray-200 dark:bg-gray-700 rounded text-xs font-mono">{t.name}</span>
          ))}
        </div>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {data.map((product: any) => (
        <div class="border dark:border-gray-700 rounded-xl p-6 shadow-sm hover:shadow-md transition bg-white dark:bg-gray-800">
           <div class="flex justify-between items-start mb-4">
             <h2 class="text-xl font-bold">{product.name}</h2>
             <span class={`px-2 py-1 rounded-full text-xs font-medium ${product.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}`}>
                {product.status}
              </span>
           </div>
           
           <p class="text-sm text-gray-400 mb-2 font-mono">{product.external_id}</p>
           <p class="mb-4 text-gray-600 dark:text-gray-300">{product.description}</p>
           
           <div class="flex justify-between items-center mt-auto pt-4 border-t dark:border-gray-700">
              <span class="text-2xl font-black text-blue-600 dark:text-blue-400">{product.price} PLN</span>
              <button class="text-sm text-blue-600 hover:text-blue-800 dark:hover:text-blue-300 font-semibold">
                View Details →
              </button>
           </div>
        </div>
      ))}
    </div>
    
    {data.length === 0 && !error && (
      <div class="text-center py-12 text-gray-500">
        <p>No products found in D1 database.</p>
        <p class="text-sm mt-2">Try running the migration or insert command.</p>
      </div>
    )}
  </div>
</Layout>
