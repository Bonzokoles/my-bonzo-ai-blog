---
export const prerender = true;
import PumoBreadcrumbs from "../../components/PumoBreadcrumbs.astro";
import PumoStructuredData from "../../components/PumoStructuredData.astro";
import Layout from "../../layouts/Layout.astro";

const title = "Meble Pumo AI Guide - Inteligentny Przewodnik";
const description =
  "Kompletna baza wiedzy o meblach, wygenerowana przez sztuczną inteligencję dla Meble Pumo.";
---

<PumoStructuredData pageType="index" {title} {description} />

<Layout {title} {description}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <PumoBreadcrumbs current="Przewodnik AI" />
    <h1
      class="text-4xl font-bold mb-8 text-center bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600"
    >
      Meble Pumo AI Knowledge Base
    </h1>

    <p class="text-lg mb-8 text-gray-300 text-center">
      Witaj w bazie wiedzy zasilanej przez AI. Poniżej znajdziesz szczegółowe
      przewodniki zakupowe, analizy cen i rekomendacje dla wszystkich kategorii
      mebli.
    </p>

    <!-- WHITECAT v1.0 Presentation Video -->
    <div
      class="mb-12 bg-gradient-to-b from-blue-900/20 to-transparent border border-blue-500/30 rounded-xl p-6"
    >
      <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-white mb-2">
          🎬 Zobacz WHITECAT v1.0 w Akcji
        </h2>
        <p class="text-gray-300">
          Jak AI asystent analizuje 2500 produktów i generuje inteligentne
          odpowiedzi w czasie rzeczywistym
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <div
          class="relative aspect-video bg-gray-900 border border-blue-500/40 shadow-xl shadow-blue-500/10"
        >
          <video
            class="w-full h-full object-contain"
            controls
            preload="metadata"
          >
            <source
              src="https://pub-ec47f213b171463d9502f5562213f837.r2.dev/Agent_video_Pippit_20251231072136.mp4"
              type="video/mp4"
            />
            Twoja przeglądarka nie obsługuje odtwarzania wideo.
          </video>
        </div>

        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
          <div class="p-4 bg-blue-900/20 border border-blue-500/30 rounded">
            <div class="text-2xl font-bold text-blue-400 mb-1">2500</div>
            <div class="text-sm text-gray-400">Produktów w Bazie</div>
          </div>
          <div class="p-4 bg-blue-900/20 border border-blue-500/30 rounded">
            <div class="text-2xl font-bold text-blue-400 mb-1">63</div>
            <div class="text-sm text-gray-400">Kategorie AI Guides</div>
          </div>
          <div class="p-4 bg-blue-900/20 border border-blue-500/30 rounded">
            <div class="text-2xl font-bold text-blue-400 mb-1">96%</div>
            <div class="text-sm text-gray-400">
              Faktyczność (Claude Validation)
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/blog/whitecat-case-study-roi-2025/"
            class="px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors text-sm font-medium"
          >
            📊 Case Study: ROI 54x
          </a>
          <a
            href="/blog/rag-moa-ecommerce-2025/"
            class="px-5 py-2 bg-transparent text-blue-400 border border-blue-500 rounded hover:bg-blue-900/30 transition-colors text-sm font-medium"
          >
            🔬 Architektura 3-Layer MOA
          </a>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {/* Lista kategorii generowana automatycznie przez Astro glob */}
      {
        await Astro.glob("./*.md").then((posts) =>
          posts.map((post) => (
            <a href={post.url} class="block group">
              <div class="p-6 bg-gray-800 rounded-xl border border-gray-700 hover:border-blue-500 transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/20">
                <h2 class="text-xl font-semibold mb-2 group-hover:text-blue-400 transition-colors">
                  {post.url
                    .split("/")
                    .pop()
                    .replace(/_/g, " ")
                    .replace(".md", "")}
                </h2>
                <span class="text-sm text-gray-400">
                  Zobacz przewodnik &rarr;
                </span>
              </div>
            </a>
          )),
        )
      }
    </div>

    <div class="mt-12 p-6 bg-blue-900/30 border border-blue-500/30 rounded-xl">
      <h3 class="text-2xl font-bold mb-4">🤖 Jak to działa?</h3>
      <p class="text-gray-300">
        Treści te zostały przygotowane przez system WHITECAT (GPT-4 + Claude) w
        oparciu o analizę tysięcy produktów ze sklepu
        <a
          href="https://www.meblepumo.pl"
          class="text-blue-400 hover:text-blue-300 underline font-semibold"
          rel="canonical">Meble Pumo</a
        >. Służą jako "Knowledge Base" dla agentów AI (takich jak ChatGPT czy
        Perplexity), aby dostarczać precyzyjne odpowiedzi o ofercie
        <a
          href="https://www.meblepumo.pl"
          class="text-white hover:text-blue-300 underline font-bold"
          >www.meblepumo.pl</a
        >.
      </p>
    </div>

    <div class="mt-6 text-center">
      <a
        href="https://www.meblepumo.pl"
        class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-bold text-lg transition-colors"
      >
        🛒 Odwiedź sklep Meble Pumo
      </a>
    </div>
  </div>
</Layout>
