---
export const prerender = true;
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PumoStructuredData from "../../components/PumoStructuredData.astro";
import Layout from "../../layouts/Layout.astro";

const title = "Meble Pumo AI Guide 2026 | 65 Kategorii - Kompletny Katalog";
const description =
  "Pełny przewodnik po 65 kategoriach Meble Pumo. AI-powered baza wiedzy z analizami cen, rekomendacjami i specyfikacjami. WHITECAT v1.0 case study.";

// Pobierz wszystkie kategorie dla ItemList schema
const allGuides = await Astro.glob("./*.md");
const categories = allGuides.map((post, index) => ({
  position: index + 1,
  name: post.url.split("/").pop().replace(/_/g, " ").replace(".md", ""),
  url: `https://www.mybonzoaiblog.com${post.url}`,
}));
---

<PumoStructuredData pageType="index" {title} {description} />

