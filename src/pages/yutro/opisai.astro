---
import Layout from "../../layouts/Layout.astro";
import YutroEnhancedSEO from "../../components/YutroEnhancedSEO.astro";

const title = "OpisAI — Generator opisów produktów AI dla Shopify i IdoSell | Yutro";
const description =
  "OpisAI automatycznie generuje opisy produktów, SEO title i meta description. Integracja z Shopify GraphQL i IdoSell API. Pierwsze 3 opisy gratis.";
---

<YutroEnhancedSEO pageType="product" product="OpisAI" {title} {description}
  canonical="https://www.mybonzoaiblog.com/yutro/opisai" />

<Layout {title} {description}>
  <div class="max-w-4xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 font-mono mb-8">
      <a href="/" class="hover:text-gray-300 transition-colors">Home</a>
      <span>/</span>
      <a href="/yutro" class="hover:text-gray-300 transition-colors">Yutro</a>
      <span>/</span>
      <span class="text-emerald-400">OpisAI</span>
    </nav>

    <!-- Hero -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/5 text-emerald-400 text-xs font-mono uppercase tracking-widest mb-5">
        SaaS · AI Generator
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        OpisAI — opisy produktów<br/>
        <span class="text-emerald-400">w 3 sekundy</span>
      </h1>
      <p class="text-gray-300 text-lg leading-relaxed max-w-2xl mb-6">
        Podaj SKU lub URL produktu — OpisAI generuje opis SEO, tytuł i meta description.
        Jedno kliknięcie zapisuje wynik bezpośrednio do Shopify przez GraphQL lub do IdoSell API.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://ai.yutro.company/" target="_blank" rel="noopener"
          class="px-6 py-2 bg-emerald-500 hover:bg-emerald-400 text-black font-bold rounded-lg transition-colors">
          Otwórz panel →
        </a>
        <a href="mailto:doyutro@yahoo.com?subject=OpisAI+trial"
          class="px-6 py-2 border border-emerald-500/40 hover:border-emerald-400 text-emerald-400 font-semibold rounded-lg transition-colors">
          3 opisy gratis
        </a>
      </div>
    </div>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      {[
        { icon: "⚡", title: "3 sekundy / opis", desc: "GPT-4o z promptami dostosowanymi pod Twoją branżę i styl komunikacji." },
        { icon: "🔗", title: "Shopify GraphQL", desc: "Bezpośredni zapis metafieldsów, opisu HTML i tytułu bez eksportu CSV." },
        { icon: "📦", title: "Batch processing", desc: "Przetwarzaj 100+ produktów jednocześnie z kolejką i progress barem." },
        { icon: "🌍", title: "Wielojęzyczność", desc: "PL, EN, DE z jednego kliknięcia. Ten sam produkt, różne języki." },
        { icon: "🔍", title: "SEO-first output", desc: "Title ≤60 znaków, meta ≤160, keyword density — gotowe pod Google i AI Overviews." },
        { icon: "🎨", title: "Prompt editor", desc: "Modyfikuj tone of voice, słowa kluczowe i strukturę opisu bez kodowania." },
      ].map(f => (
        <div class="p-5 border border-gray-800 rounded-xl bg-gray-900/50">
          <div class="text-2xl mb-3">{f.icon}</div>
          <div class="font-bold text-white mb-2">{f.title}</div>
          <div class="text-sm text-gray-400">{f.desc}</div>
        </div>
      ))}
    </div>

    <!-- Pricing -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Cennik OpisAI</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          { name: "Starter", price: "99 PLN", per: "/ mies.", features: ["200 opisów / mies.", "1 sklep", "PL + EN", "Email support"], cta: "Zacznij" },
          { name: "Pro", price: "249 PLN", per: "/ mies.", features: ["1000 opisów / mies.", "3 sklepy", "PL + EN + DE", "Prompt editor", "Priority support"], cta: "Wybierz Pro", highlight: true },
          { name: "Agency", price: "na zapytanie", per: "", features: ["Nielimitowane opisy", "Nielimitowane sklepy", "White-label", "API access", "Dedykowany opiekun"], cta: "Napisz" },
        ].map(p => (
          <div class={`p-6 rounded-xl border ${p.highlight ? 'border-emerald-500/60 bg-emerald-500/5' : 'border-gray-800 bg-gray-900/50'}`}>
            <div class="font-bold text-white mb-1">{p.name}</div>
            <div class={`text-3xl font-bold mb-1 ${p.highlight ? 'text-emerald-400' : 'text-white'}`}>{p.price}</div>
            <div class="text-xs text-gray-500 mb-5">{p.per}</div>
            <ul class="space-y-2 mb-6">
              {p.features.map(f => (
                <li class="flex items-center gap-2 text-sm text-gray-300">
                  <span class="text-emerald-400">✓</span> {f}
                </li>
              ))}
            </ul>
            <a href="mailto:doyutro@yahoo.com?subject=OpisAI+{p.name}"
              class={`block text-center py-2 rounded-lg font-semibold text-sm transition-colors
                ${p.highlight ? 'bg-emerald-500 hover:bg-emerald-400 text-black' : 'border border-gray-700 hover:border-emerald-500/40 text-gray-300 hover:text-emerald-400'}`}>
              {p.cta}
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Back link -->
    <div class="border-t border-gray-800 pt-8">
      <a href="/yutro" class="text-sm text-gray-500 hover:text-emerald-400 transition-colors font-mono">
        ← Wróć do wszystkich produktów Yutro
      </a>
    </div>

  </div>
</Layout>
